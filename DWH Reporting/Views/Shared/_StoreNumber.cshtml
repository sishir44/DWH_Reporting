<body style="padding-top:0; background-color:#B2D6F2;" class="partialPage">

    <!-- LOADING LOGO -->
    <div id="loadingScreen">
        <img id="loadingLogo" src="https://mis.mobilyllc.com/mobilylogin/image/mobilyloader.gif" alt="Loading Logo">
    </div>

    <div>
        <div id="content" class="content" style="background-color:#B2D6F2;">

            <!-- TITLE & DATE FILTER & EXPORT BTN-->
            <div class="row head">
                <!-- Title Section -->
                <div class="col-lg-8 col-md-12 col-sm-12 col-xs-12">
                    <div class="row">
                        <h3 style="margin-top:10px; margin-left:50px; font-weight:800; font-size:16px;" class="title">
                            | EOM @ViewBag.Title
                        </h3>
                    </div>
                </div>

                <!-- Controls Section -->
                <div class="col-lg-4 col-md-12 col-sm-12 col-xs-12">
                    @{
                        var today = DateTime.Today.ToString("yyyy-MM-dd");
                        var yesterday = DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd");
                    }

                    <div class="d-flex flex-wrap align-items-start justify-content-end" style="gap: 6px;">
                        @using (Html.BeginForm("StoreNumber", "Home", FormMethod.Post, new { id = "storeForm" }))
                        {

                            <!-- Hidden Inputs -->
                            <input type="hidden" id="isFinal" value="0" />
                            <input type="hidden" id="hiddenDate" name="selectedDate" />
                            <!-- Daily Date Picker (Visible initially) -->
                            if (ViewBag.isfinal == "1")
                            {
                                <input type="date"
                                       id="selectedDate"
                                       class="form-control"
                                       title="Select Date" hidden
                                       style="width:140px; background-color:#A5CFF0; font-size:12px; font-weight:bold; color:#383b3f; height:30px; border:black;" />
                                <!-- Monthly Picker (Hidden initially) -->
                                <input type="month"
                                       id="monthPicker"
                                       class="form-control"
                                       title="Select Month"
                                       style="width:140px; background-color:#A5CFF0; font-size:12px; font-weight:bold; color:#383b3f; height:30px; border:black;" />
                            }
                        }
                        <!-- Toggle Button -->
                        <button type="button"
                                id="toggleBtn"
                                class="btn btn-primary"
                                title="Toggle EOM/MTD"
