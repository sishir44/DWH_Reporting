    function LoadNoteandCommentData() {
        // Reset the employee dropdown to "Select an Employee"
        document.getElementById("ddCommentDesignation").selectedIndex = 0;
        // Clear the textarea
        document.getElementById("noteTextArea").value = "";
        document.getElementById("commentTextArea").value = "";
    }

    function resetEmployeeDD() {
        // Reset the employee dropdown to "Select an Employee"
        document.getElementById("ddCommentDesignation").selectedIndex = 0;
        // Clear the textarea
        document.getElementById("noteTextArea").value = "";
        document.getElementById("commentTextArea").value = "";
    }

    function loadNoteData(uniqueID, dealercode, datekey, TM, SD, MULMngr, RSMSRSM) {

        resetEmployeeDD();

        $.ajax({
            //url: '../Home/SaveUniqueIDToSession', // Route to save UniqueID in session
            url:'@Url.Action("SaveUniqueIDToSession", "Home")',
            type: 'POST',
            data: {
                UniqueID: uniqueID,
                DealerCode: dealercode,
                DateKey: datekey,
                TM: TM,
                SD: SD,
                MULMngr: MULMngr,
                RSMSRSM: RSMSRSM
            }
        });

        // AJAX call to the server to get note data
        $.ajax({
    url: '@Url.Action("GetNoteData", "Home")',
    type: 'POST',
    data: {
        UniqueID: uniqueID,
        TM: TM,
        SD: SD,
        MULMngr: MULMngr,
        RSMSRSM: RSMSRSM
    },
    success: function (response) {
        console.log(response);

        var selectElement = document.getElementById("ddCommentDesignation");
        selectElement.innerHTML = ""; // Clear existing options

        // Define key-value pairs (label and value)
        var designations = {
            "TM": TM,
            "SD": SD,
            "MMM": MULMngr,
            "RSM": RSMSRSM
        };

        // Add formatted options
        for (var key in designations) {
            if (designations[key]) {
                var option = document.createElement("option");
                option.text = key + " - " + designations[key];
                option.value = designations[key];
                option.style.backgroundColor = "lightblue";
                selectElement.add(option);
            }
        }

        // Now handle response
        if (response && response.Note) {
            document.getElementById("noteTextArea").value = response.Note;
            document.getElementById("commentTextArea").value = response.Comment;

            // Set selected option based on response.Employee
            for (var i = 0; i < selectElement.options.length; i++) {
                if (selectElement.options[i].text === response.Employee) {
                    selectElement.selectedIndex = i;
                    break;
                }
            }

        } else {
            // No data case
            document.getElementById("noteTextArea").value = "";
            document.getElementById("commentTextArea").value = "";
            selectElement.selectedIndex = 0;
        }
    }
});
    }

    function addnote() {
        if (validateDropdown()) {
            var comment = document.getElementById("commentTextArea").value;
        var note = document.getElementById("noteTextArea").value;
        var empSelect = document.getElementById("ddCommentDesignation");
        var empText = empSelect.options[empSelect.selectedIndex].text;

        // AJAX call to insert or update note
        $.ajax({
            //url: '../Home/AddOrUpdateNote', // Adjust to your controller path
            url:'@Url.Action("AddOrUpdateNote", "Home")',
            type: 'POST',
            data: {
                Comment: comment,
                Note: note,
                Employee: empText
            },
            success: function (response) {
                Swal.fire({
                    icon: "success",
                    title: response.message,
                    showConfirmButton: true,
                }).then((result) => {
                    if (result.isConfirmed) {
                        location.reload();
                    }
                });
                //alert(response.message);
            },
            error: function (xhr, status, error) {
                console.error("Error:", error);

            }
        });
        }

    }

