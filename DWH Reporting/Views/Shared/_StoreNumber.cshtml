    function TIRfilterStoresOptions(selectedValues) {
        var StoresSelect = document.getElementById('Stores');
        //console.log(selectedValues);

        // Clear the Stores dropdown
        StoresSelect.innerHTML = '';

        // Get all visible table rows after the SD filter
        var filteredRows = Array.from(document.querySelectorAll('#tbl tbody tr'))
            .filter(row => row.style.display !== 'none' && selectedValues.includes(row.getAttribute('data-tir')));

        // Collect all unique Stores values from the filtered rows
        var availableStores = new Set();
        filteredRows.forEach(row => {

            var StoresValue = row.getAttribute('data-store');
            if (StoresValue) {
                availableStores.add(StoresValue);
            }
        });

        // If any SD is selected, disable the Stores dropdown but populate with matching options
        if (selectedValues.length > 0) {
            /*StoresSelect.disabled = true;*/  // Keep the dropdown disabled if required

            // Populate the Stores dropdown with only the Stores from filtered rows
            availableStores.forEach(StoresValue => {
                var option = document.createElement('option');
                option.value = StoresValue;
                option.text = StoresValue;
                option.style.color = 'grey';
                option.style.fontSize = '10px';
                StoresSelect.add(option);
            });
        } else {
            // If no SD is selected, enable the Stores dropdown and reset all options
            //StoresSelect.disabled = false;

            // Optionally, repopulate with all Stores (e.g., from original ViewBag or data source)
            var allRows = document.querySelectorAll('#tbl tbody tr');
            allRows.forEach(row => {
                var StoresValue = row.getAttribute('data-store');
                if (StoresValue) {
                    var option = document.createElement('option');
                    option.value = StoresValue;
                    option.text = StoresValue;
                    StoresSelect.add(option);
                }
            });
        }
    }
    //////////////////////////////////////////////////////

</script>

