    function test() {
        $("#tbl, #tbl2").find("td:hidden, th:hidden, [style*='display: none']").remove();
        const wb = XLSX.utils.book_new();
        const tables = [
            { selector: "#tbl", name: "Table1" },
            { selector: "#tbl2", name: "Table2" }
        ];
        tables.forEach(t => {
            const elt = document.querySelector(t.selector);
            if (elt) {
                const ws = XLSX.utils.table_to_sheet(elt);
                XLSX.utils.book_append_sheet(wb, ws, t.name);
            }
        });
        const btn = document.getElementById("toggleBtn");
        const isEOM = btn.innerText === "MTD";
        const filename = isEOM ? "NewStoreNumberReport EOM.xlsx" : "NewStoreNumberReport MTD.xlsx";
        XLSX.writeFile(wb, filename);
    }



    function printTable() {
        //Hide all unnecessary elements by adding a 'print-hidden' class
        var elementsToHide = document.querySelectorAll('header, footer, .sidebar, .navbar, .other-section'); // Customize this to the elements you want hidden
        elementsToHide.forEach(function (el) {
            el.style.display = 'none';
        });

        // Temporarily show only the table
        var table = document.getElementById("tbl");
        table.style.display = 'table'; // Ensure the table is displayed

        // Open the print dialog
        window.print();

        // Restore visibility of previously hidden elements
        elementsToHide.forEach(function (el) {
            el.style.display = ''; // Restore to default
        });
    }

