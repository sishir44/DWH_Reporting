    }
    function roundToOne(num) {
        return +(Math.round(num + "e+1") + "e-1");
    }

    function addCommaswithRound(nStr) {
        nStr = Math.round(nStr);
    nStr += '';
    x = nStr.split('.');
    x1 = x[0];
    x2 = x.length > 1 ? '.' + x[1] : '';
    var rgx = /(\d+)(\d{3})/;
    while (rgx.test(x1)) {
        x1 = x1.replace(rgx, '$1' + ',' + '$2');
    }
    var x = x1 + x2;
    return x;
};
