    function filtermmmData(event) {
        // Get MMM select element
        var mmmSelect = document.getElementById('MULMngr');

        // Text of the option that was last clicked
        var clickedOptionText = event
            ? event.target.options[event.target.selectedIndex].text
            : (mmmSelect.selectedOptions.length > 0 ? mmmSelect.selectedOptions[0].text : '');

        // Get all selected values
        var selectedValues = Array.from(mmmSelect.selectedOptions).map(option => option.value);

        // Filter rows manually
        var rows = document.querySelectorAll('#tbl tbody tr');
        rows.forEach(row => {
            var mmmValue = row.getAttribute('data-mmm');

            if (row.classList.contains('total_dataTM') || row.classList.contains('total_dataMMM')) {
                row.style.display = 'none'; // Always hide TM/MMM totals
            }
            else if (row.classList.contains('total_data')) {
                row.style.display = ''; // Always show "Grand Total"
            }
            else if (selectedValues.length === 0 || selectedValues.includes(mmmValue)) {
                row.style.display = '';
            }
            else {
                row.style.display = 'none';
            }
        });

        // Search filter input
        var input = document.getElementById('textSearchMULMngr').value.toUpperCase();

        // Apply DataTables filter only if DataTables is loaded and initialized
        if ($.fn.dataTable && $.fn.dataTable.isDataTable('#tbl')) {
            $.fn.dataTable.ext.search = []; // clear old filters
            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                var rowContent = data.join(' ').toUpperCase();
                var row = $('#tbl tbody tr').eq(dataIndex);

                if (row.hasClass('total_dataTM') || row.hasClass('total_dataMMM')) {
                    return false; // Always hide TM/MMM totals
                }
                if (row.hasClass('total_data')) {
                    return true; // Always keep Grand Total
                }
                return rowContent.indexOf(input) > -1 || input === '';
            });
            $('#tbl').DataTable().draw();
        }

        // Update other dependent dropdowns
        var tmSelect = document.getElementById('TM');
        var mktSelect = document.getElementById('Market');

        if (tmSelect.disabled) {
            mmmfiltermmmOptions(selectedValues);
            mmmfilterTiersOptions(selectedValues);
            mmmfilterStoresOptions(selectedValues);

            mktSelect.disabled = true;
            mmmSelect.disabled = true;

            $('tr.filter_data').remove();
            loadGTotalByFilter(tmSelect.innerText, mktSelect.innerText, clickedOptionText, null, null, null);
        }
        else if (mktSelect.disabled) {
            mmmfiltermmmOptions(selectedValues);
            mmmfilterTiersOptions(selectedValues);
            mmmfilterStoresOptions(selectedValues);

            mmmSelect.disabled = true;

            $('tr.filter_data').remove();
            loadGTotalByFilter(tmSelect.innerText, mktSelect.innerText, clickedOptionText, null, null, null);
        }
        else {
            mmmfilterTMOptions(selectedValues);
            mmmfilterMarketOptions(selectedValues);
            mmmfiltermmmOptions(selectedValues);
            mmmfilterTiersOptions(selectedValues);
            mmmfilterStoresOptions(selectedValues);

            tmSelect.disabled = true;
            mktSelect.disabled = true;
            mmmSelect.disabled = true;

            $('tr.filter_data').remove();
            loadGTotalByFilter(null, null, clickedOptionText, null, null, null);
        }
    }

