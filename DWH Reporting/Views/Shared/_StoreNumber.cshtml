    function TiersFilter() {
        const searchInput = document.getElementById('textSearchTiers').value.toLowerCase();
        const options = document.querySelectorAll('#Tiers option');

        options.forEach(option => {
            if (option.textContent.toLowerCase().includes(searchInput)) {
