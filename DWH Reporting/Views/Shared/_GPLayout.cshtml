        .dropdown.for-message.show .dropdown-menu {
            width: 12rem !important;
        }


        .top-right .header-menu .user-area span {
            display: none;
        }

        .dropbtn {
            background-color: #4CAF50;
            color: white;
            font-size: 16px;
            border: none;
        }

        .dropdown.my_portal, .dropdown.my_portal1 {
            position: relative;
            display: inline-block;
        }

        .dropdown-content, .dropdown-content1 {
            display: none;
            position: absolute;
            background-color: #f1f1f1;
            min-width: 310px;
            left: -150px;
            box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
            z-index: 1;
            padding: 11px;
            max-height: 330px;
            overflow: auto;
        }

            /* Links inside the dropdown */
            .dropdown-content a, .dropdown-content1 a {
                color: black;
                padding: 0px 16px;
                text-decoration: none;
                display: block;
                line-height: 2;
            }

                /* Change color of dropdown links on hover */
                .dropdown-content a:hover, .dropdown-content1 a:hover {
                    background-color: #ddd;
                }

        /* Show the dropdown menu on hover */
        .dropdown.my_portal:hover .dropdown-content, .dropdown.my_portal1:hover .dropdown-content {
            display: block;
        }

        /* Change the background color of the dropdown button when the dropdown content is shown */
        .dropdown.my_portal:hover .dropbtn, .dropdown.my_portal1:hover .dropbtn {
            background-color: #3e8e41;
        }

        .chat_btn {
            border-radius: 100%;
            position: fixed;
            bottom: 20px;
            right: 30px;
            z-index: 9;
            display: none;
        }

        button.chat_btn > i {
            font-size: 40px;
        }

        .chat_close {
            display: none;
        }

        .chat_open {
            display: block;
            width: 30%;
            position: fixed;
            z-index: 9999;
            background: #017bffe6;
            right: 30px;
            bottom: 80px;
            border-radius: 5px;
        }

        .containerSchbox {
            position: absolute;
            margin: auto;
            height: 50px;
        }

            .containerSchbox .search {
                background: url("https://mis.mobilelinkusa.com/loginuser/img/icons/activesearch.png") no-repeat;
                background-size: cover;
                position: absolute;
                margin: auto;
                top: 0;
                right: 0;
                bottom: 0;
                left: 0;
                width: 26px;
                height: 26px;
                border-radius: 50%;
                transition: all 3s;
                z-index: 999;
            }

                .containerSchbox .search:hover {
                    cursor: pointer;
                }

            .containerSchbox input {
                display: none;
                font-family: 'XBRoyaBold','Inconsolata', monospace;
                position: absolute;
                margin: auto;
                text-align: left;
                top: 0;
                right: 0;
                bottom: 0;
                left: -4px;
                width: 19px;
                height: 30px;
                outline: none;
                border: none;
                background: white;
                color: gray;
                padding: 0 10px 0 20px;
                border-radius: 30px;
                border: 2px solid #6e9589;
                transition: 1s;
                opacity: 0;
                z-index: 5;
                font-weight: bolder;
            }

                .containerSchbox input:hover {
                    cursor: pointer;
                }

                .containerSchbox input:focus {
                    width: 200px;
                    opacity: 1;
                    cursor: text;
                    left: -162px;
                }

                    .containerSchbox input:focus ~ .search {
                        right: -40px;
                        background: #green;
                        z-index: 6;
                    }

                        .containerSchbox input:focus ~ .search::before {
                            top: 0;
                            left: 0;
                            width: 26px;
                        }

                        .containerSchbox input:focus ~ .search::after {
                            top: 0;
                            left: 0;
                            width: 26px;
                            height: 2px;
                            border: none;
                            background: white;
                            border-radius: 0%;
                            transform: rotate(-45deg);
                        }

                .containerSchbox input::placeholder {
                    color: black;
                    opacity: 0.5;
                    font-weight: bolder;
                }

        .btn-success {
            background: #336a59;
            border: 1px solid #1d4622;
        }
    </style>
