        }

        .card {
            -webkit-box-shadow: 10px 16px 11px #bbbbbb;
            box-shadow: 10px 16px 11px #bbbbbb;
        }

        #weatherWidget .currentDesc {
            color: #ffffff !important;
        }

        .traffic-chart {
