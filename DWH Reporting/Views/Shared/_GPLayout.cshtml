        .mini-sidebar .sidebar .sidebar-footer {
            width: 60px;
            -webkit-transition: all 0.2s ease-in-out 0s;
            -moz-transition: all 0.2s ease-in-out 0s;
            transition: all 0.2s ease-in-out 0s;
        }

        .mini-sidebar.expand-menu .sidebar .sidebar-footer {
            width: 230px;
            transition: all 0.2s ease-in-out 0s;
            -webkit-transition: all 0.2s ease-in-out 0s;
            -moz-transition: all 0.2s ease-in-out 0s;
        }

        .sidebar-footer {
            padding: 0;
            position: fixed;
            left: 0;
            bottom: 0;
            z-index: 999;
        }

            .sidebar-footer a {
                padding: 7px 0 3px;
                text-align: center;
                width: 25%;
                font-size: 17px;
                display: block;
                float: left;
                background: #347D3D;
                cursor: pointer;
                color: #fff;
            }

                .sidebar-footer a:hover {
                    background: #2f6051;
                    color: #fff;
                }

        .notification {
            background-color: #555;
            color: white;
            text-decoration: none;
            padding: 15px 26px;
            position: relative;
            display: inline-block;
            border-radius: 2px;
        }

        .badge-danger {
            color: #fff;
            background-color: red;
        }

        .notification .badge {
            position: absolute;
            top: -10px;
            right: -10px;
            padding: 5px 10px;
            border-radius: 50%;
            background: red;
            color: white;
        }

        body {
            color: #45484a;
            background: #e7ede6;
            background: url(../../stgloginuser/Image/back.png);
