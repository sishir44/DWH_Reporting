    function loadNoteData(uniqueID, dealercode, datekey) {
        resetEmployeeDD();

        $.ajax({
            url: '/Home/SaveUniqueIDToSession', // Route to save UniqueID in session
            type: 'POST',
            data: {
                UniqueID: uniqueID,
                DealerCode: dealercode,
                DateKey: datekey
            }
        });

        // AJAX call to the server to get note data
        $.ajax({
            url: '/Home/GetNoteData', // Ensure this matches your route
            type: 'POST',
            data: { UniqueID: uniqueID },
            success: function (response) {
                //console.log("Response received:", response); // Check the structure
                if (response && response.Note) {
                    document.getElementById("noteTextArea").value = response.Note;
                    document.getElementById("commentTextArea").value = response.Comment;

                    var selectElement = document.getElementById("ddCommentDesignation");
                    var options = selectElement.options;
                    for (var i = 0; i < options.length; i++) {
                        if (options[i].text === response.Employee) {  // Match by text
                            selectElement.selectedIndex = i;          // Set selected option
                            break;
                        }
                    }

                } else {
                    //console.log("No data for notes received.");
                    document.getElementById("noteTextArea").value = "";
                    document.getElementById("commentTextArea").value = "";
                    document.getElementById("ddCommentDesignation").selectedIndex = 0;
                }
            }
        });
    }

    function addnote() {

        var comment = document.getElementById("commentTextArea").value;
        var note = document.getElementById("noteTextArea").value;
        var empSelect = document.getElementById("ddCommentDesignation");
        var empText = empSelect.options[empSelect.selectedIndex].text;

        // AJAX call to insert or update note
        $.ajax({
            url: '/Home/AddOrUpdateNote', // Adjust to your controller path
            type: 'POST',
            data: {
                Comment: comment,
                Note: note,
                Employee: empText
            },
            success: function (response) {
                alert(response.message); // Display a success or error message
            },
            error: function (xhr, status, error) {
                console.error("Error:", error);
                alert("There was an error saving the note.");
            }
        });
    }

    function formatValue(value) {
        // Ensure the value is treated as a string
        value = value.toString();

        // Remove commas from the value
        value = value.replace(/,/g, "");

        if (value === null || value === undefined || isNaN(value)) {
            return "0.00"; // Default for empty or null values
        }

        //// Remove the `$` symbol only if it's at the start of the string
        //if (value.startsWith("$")) {
        //    value = value.substring(1); // Remove the first character
        //}

        //// Remove any other unwanted symbols like `%` using regex
        //value = value.replace(/[^0-9.-]/g, "");

        //// Check if the cleaned value is valid
        //if (isNaN(value) || value.trim() === "") {
        //    return "0.00"; // Default for invalid values
        //}

        // Format to 1 decimal place
        return parseFloat(value).toFixed(1);
    }

