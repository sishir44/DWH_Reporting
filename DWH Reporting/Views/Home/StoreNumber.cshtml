<!--Highlight values-->
<script>
    // Function to highlight TM and Store cells
    function highlightCells() {
        //GROSS ADDS Goals
        var cells = document.querySelectorAll(".gross-adds-goals");

        cells.forEach(function (cell) {
            // Parse the cell's text content as a float
            var value = parseFloat(cell.textContent);

            // Check if the value is greater than 50
            if (!isNaN(value) && value > 70.0) {
                cell.style.backgroundColor = "green";  // Set background color
                cell.style.color = "white";  // Set text color
            }

            // Check if the value is greater than 50
            if (!isNaN(value) && value < 60.0) {
                cell.style.backgroundColor = "yellow";  // Set background color
                cell.style.color = "black";  // Set text color
            }
        });

        //CSAT
        var csat = document.querySelectorAll(".csat");

        csat.forEach(function (cell) {

            var value = parseFloat(cell.textContent);

            if (!isNaN(value) && value > 0.7) {
                cell.style.backgroundColor = "green";
                cell.style.color = "white";
            }

            if (!isNaN(value) && value < 0.7) {
                cell.style.backgroundColor = "yellow";
                cell.style.color = "black";
            }
        });

        //Total Stores
        // Select all cells with the 'stores' class
        var storeCells = document.querySelectorAll(".stores");
        var storeCount = 0;

        // Loop through each cell and count if it has a store name
        storeCells.forEach(function (cell) {
            var storeName = cell.textContent.trim();

            // Check if the cell has a non-empty store name
            if (storeName) {
                storeCount++;
            }
        });

        // Display the count in the view by setting it to an element's text content
        //document.getElementById("storeCountDisplay").textContent = storeCount;
        document.getElementById("storeCountDisplay").value = storeCount;



    }
    // Call the function to apply the highlighting
    highlightCells();
</script>

