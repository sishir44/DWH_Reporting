<!--Highlight Trending Break Even-->
<script>
    document.addEventListener("DOMContentLoaded", function () {

        //Total Stores
        // Select all cells with the 'stores' class
        var storeCells = document.querySelectorAll(".stores");
        var storeCount = 0;

        // Loop through each cell and count if it has a store name
        storeCells.forEach(function (cell) {
            var storeName = cell.textContent.trim();

            // Check if the cell has a non-empty store name
            if (storeName) {
                storeCount++;
            }
        });

        // Display the count in the view by setting it to an element's text content
        //document.getElementById("storeCountDisplay").textContent = storeCount;
        document.getElementById("storeCountDisplay").value = storeCount;




        // Tr Break Even Calc
        var tbeCells = document.querySelectorAll(".tbreakevenCLS");
        var tbeCount = 0;
        var tbeCount70 = 0;
        var tbeCount90 = 0;

        tbeCells.forEach(function (cell) {
            var tbeValue = parseFloat(cell.textContent.replace('%', '').trim());
            if (!isNaN(tbeValue) && tbeValue > 100) {
                tbeCount++;
            }
            if (!isNaN(tbeValue) && tbeValue > 70 && tbeValue < 100) {
                tbeCount70++;
            }
            if (!isNaN(tbeValue) && tbeValue < 70) {
                tbeCount90++;
            }
        });

        var tbeCountDisplay = document.getElementById("tbeCountDisplay");
        if (tbeCountDisplay) {
            tbeCountDisplay.value = tbeCount;
        }

        var tbeCountDisplay70 = document.getElementById("tbeCountDisplay70");
        if (tbeCountDisplay70) {
            tbeCountDisplay70.value = tbeCount70;
        }

        var tbeCountDisplay90 = document.getElementById("tbeCountDisplay90");
        if (tbeCountDisplay90) {
            tbeCountDisplay90.value = tbeCount90;
        }
    });

</script>
