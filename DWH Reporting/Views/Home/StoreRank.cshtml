    ////////////////TM Hierarchy/////////////////////////
    function filterTMData() {
        // Get selected Tiers values from the dropdown
        var selectedValues = Array.from(document.getElementById('TM').selectedOptions).map(option => option.value);
        //console.log(selectedValues);

        // Get all rows in the table
        var rows = document.querySelectorAll('#tbl tbody tr');
        var totalCSAT = 0;  // Initialize CSAT total
        var totalBHRS = 0;
        var totalTraffic = 0;
        var totalOps = 0;


        // Loop through each row and check if the Tiers column matches the selected values
        rows.forEach(row => {
            var StoresValue = row.getAttribute('data-tm');
            var csatValue = parseFloat(row.getAttribute('data-csat')) || 0;  // Get the CSAT value from data-csat attribute
            var bhrsValue = parseFloat(row.getAttribute('data-bhrs')) || 0;
            var trafValue = parseFloat(row.getAttribute('data-Traffic')) || 0;
            var opsValue = parseFloat(row.getAttribute('data-OPS')) || 0;

            if (row.classList.contains('total_dataTM')) {
                row.style.display = 'none';  // Always show the "Grand Total" row

            }
            // Check if this row is the "Grand Total" row
            if (row.classList.contains('total_data')) {
                row.style.display = '';  // Always show the "Grand Total" row

            } else if (selectedValues.length === 0 || selectedValues.includes(StoresValue)) {
                row.style.display = '';  // Show row if Tiers matches or if no REGION is selected
                totalCSAT += csatValue;  // Sum the CSAT value for visible rows
                totalBHRS += bhrsValue;
                totalTraffic += trafValue;
                totalOps += opsValue;

            } else {
                row.style.display = 'none';  // Hide row if Tiers does not match

            }
        });

        // Handle the search input filter for DataTables
        var input = document.getElementById('textSearchTM').value.toUpperCase();

        // Use the DataTables custom filter API
        $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
            var rowContent = data.join(' ').toUpperCase();

            // Check if the row contains the input
            var row = $('#tbl tbody tr').eq(dataIndex);

            // Always return true for the "Grand Total" row
            if (row.hasClass('total_data')) {
                return true;  // Always show the "Grand Total" row
            }

            // If the row contains the input, return true to keep it visible
            return rowContent.indexOf(input) > -1 || input === '';
        });

        // Redraw the table with the new search criteria
        $('#tbl').DataTable().draw();

        // Remove the custom search after use to avoid stacking filters
        $.fn.dataTable.ext.search.pop();

        //Hierarchy Now handle disabling and filtering the others dropdowns

        //TM

        //var sdAlreadySelected = document.getElementById('SD');
        //var mktAlreadySelected = document.getElementById('Market');
        var tmAlreadySelected = document.getElementById('TM');


        //Fill TM and Others

        TMfilterTMOptions(selectedValues);
        TMfilterMarketOptions(selectedValues);
        TMfilterStoresOptions(selectedValues);
        TMfilterTiersOptions(selectedValues);
        TMfilterSDOptions(selectedValues);

        tmAlreadySelected.disabled = true;

        // Set the value of the input button to display the total CSAT
        document.getElementById('csatTotal').value = totalCSAT.toFixed(1);
        document.getElementById('bhrsTotal').value = totalBHRS.toFixed(1);
        document.getElementById('trafTotal').value = totalTraffic.toFixed(1);
        document.getElementById('opsTotal').value = totalOps.toFixed(1);
    }

