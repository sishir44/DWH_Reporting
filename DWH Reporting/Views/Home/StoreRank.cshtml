<script>
    const divs = document.querySelectorAll(".content");
    let currentDiv = 0;
    function showDiv(index) {
        divs.forEach((div, i) => {
            div.style.display = i === index ? "block" : "none";
        });
    }
    function showNextDiv() {
        //console.log(currentDiv);
        if (currentDiv === 0) {
            //console.log(currentDiv);
            currentDiv = 2;
            showDiv(currentDiv);
            document.getElementById("nextBtn").disabled = true;
            document.getElementById("nextBtn").style.color = 'red';

            document.getElementById("prevBtn").disabled = false;
            document.getElementById("prevBtn").style.color = 'white';
        }
    }
    function showPrevDiv() {
        if (currentDiv === 2) {
            currentDiv = 0;
            showDiv(currentDiv);
            document.getElementById("nextBtn").disabled = false;
            document.getElementById("nextBtn").style.color = 'white';

            document.getElementById("prevBtn").disabled = true;
            document.getElementById("prevBtn").style.color = 'red';
        }
    }
    // Initialize by showing the first div
    showDiv(currentDiv);
    document.getElementById("nextBtn").addEventListener("click", showNextDiv);
    document.getElementById("prevBtn").addEventListener("click", showPrevDiv);
</script>

