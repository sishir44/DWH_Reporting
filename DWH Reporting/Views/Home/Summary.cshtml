    function filterTiersData(event) {
        // Get Tiers select element
        var tiersSelect = document.getElementById('Tiers');

        // Text of the option that was last clicked
        var clickedOptionText = event
            ? event.target.options[event.target.selectedIndex].text
            : (tiersSelect.selectedOptions.length > 0 ? tiersSelect.selectedOptions[0].text : '');

        // Get all selected values
        var selectedValues = Array.from(tiersSelect.selectedOptions).map(option => option.value);

        // Filter rows manually
        var rows = document.querySelectorAll('#tbl tbody tr');
        rows.forEach(row => {
            var tiersValue = row.getAttribute('data-tir');
            if (row.classList.contains('total_data')) {
                row.style.display = ''; // Always show "Grand Total"
            } else if (selectedValues.length === 0 || selectedValues.includes(tiersValue)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });

        // Search filter input
        var input = document.getElementById('textSearchTiers').value.toUpperCase();

        // Apply DataTables filter only if DataTables is loaded and initialized
        if ($.fn.dataTable && $.fn.dataTable.isDataTable('#tbl')) {
            $.fn.dataTable.ext.search = []; // clear old filters
            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                var rowContent = data.join(' ').toUpperCase();
                var row = $('#tbl tbody tr').eq(dataIndex);
                if (row.hasClass('total_data')) {
                    return true;
                }
                return rowContent.indexOf(input) > -1 || input === '';
            });
            $('#tbl').DataTable().draw();
        }

        // Handle hierarchy-based filtering
        var tmSelect = document.getElementById('TM');
        var mktSelect = document.getElementById('Market');
        var storSelect = document.getElementById('Stores');

        if (tmSelect.disabled && mktSelect.disabled && storSelect.disabled) {
            TIRfilterTiersOptions(selectedValues);
            TIRfilterSDOptions(selectedValues);
            tiersSelect.disabled = true;
            loadGTotalByFilter(tmSelect.innerText, mktSelect.innerText);
        }
        else if (tmSelect.disabled && mktSelect.disabled) {
            TIRfilterStoresOptions(selectedValues);
            TIRfilterTiersOptions(selectedValues);
            TIRfilterSDOptions(selectedValues);
            storSelect.disabled = true;
            tiersSelect.disabled = true;
        }
        else if (tmSelect.disabled) {
            TIRfilterMarketOptions(selectedValues);
            TIRfilterStoresOptions(selectedValues);
            TIRfilterTiersOptions(selectedValues);
            TIRfilterSDOptions(selectedValues);
            mktSelect.disabled = true;
            storSelect.disabled = true;
            tiersSelect.disabled = true;
        }
        else if (storSelect.disabled) {
            TIRfilterTiersOptions(selectedValues);
            TIRfilterSDOptions(selectedValues);
            tiersSelect.disabled = true;
        }
        else {
            TIRfilterTMOptions(selectedValues);
            TIRfilterMarketOptions(selectedValues);
            TIRfilterStoresOptions(selectedValues);
            TIRfilterTiersOptions(selectedValues);
            TIRfilterSDOptions(selectedValues);
            tmSelect.disabled = true;
            mktSelect.disabled = true;
            storSelect.disabled = true;
            tiersSelect.disabled = true;
            $('tr.filter_data').remove();
            loadGTotalByFilter('', '', '', '', tiersSelect.innerText);
        }

        // Remove filter rows if fully disabled
        $('tr.filter_data').remove();

        // Pass clicked option text to totals function
        if (clickedOptionText) {
            loadGTotalByFilter(clickedOptionText);
        }
    }


