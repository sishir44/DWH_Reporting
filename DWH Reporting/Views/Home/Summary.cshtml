    function filterTMData(event) {
        // Get TM select element
        var tmSelect = document.getElementById('TM');
        // Text of the option that was last clicked
        var clickedOptionText = event
            ? event.target.options[event.target.selectedIndex].text
            : (tmSelect.selectedOptions.length > 0 ? tmSelect.selectedOptions[0].text : '');
        // Get all selected values
        var selectedValues = Array.from(tmSelect.selectedOptions).map(option => option.value);
        // Filter rows manually
        var rows = document.querySelectorAll('#tbl tbody tr');
        rows.forEach(row => {
            var StoresValue = row.getAttribute('data-tm');
            if (row.classList.contains('total_data')) {
                row.style.display = '';
            } else if (selectedValues.length === 0 || selectedValues.includes(StoresValue)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });

        // Search filter input
        var input = document.getElementById('textSearchTM').value.toUpperCase();

        // Apply DataTables filter only if DataTables is loaded and initialized
        if ($.fn.dataTable && $.fn.dataTable.isDataTable('#tbl')) {
            $.fn.dataTable.ext.search = []; // clear old filters
            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                var rowContent = data.join(' ').toUpperCase();
                var row = $('#tbl tbody tr').eq(dataIndex);
                if (row.hasClass('total_data')) {
                    return true;
                }
                return rowContent.indexOf(input) > -1 || input === '';
            });
            $('#tbl').DataTable().draw();
        }
        // Call other filter functions
        TMfilterTMOptions(selectedValues);
        TMfilterMarketOptions(selectedValues);
        TMfilterStoresOptions(selectedValues);
        TMfilterTiersOptions(selectedValues);
        TMfilterSDOptions(selectedValues);
        // Disable TM select and remove filter rows
        tmSelect.disabled = true;
        $('tr.filter_data').remove();
        // Pass clicked option text to function
        if (clickedOptionText) {
            loadGTotalByFilter(clickedOptionText);
        }
    }



