<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    function getLastDayOfMonth(year, month) {
        return new Date(year, month, 1).toISOString().split('T')[0];
    }

    function toggleMtdEom() {
        $('#tblDetBdy').empty("");
        const isFinal = $('#isFinal').val();
        const newIsFinal = isFinal === "0" ? "1" : "0";
        let datefilter = "";
        $('#isFinal').val(newIsFinal);

        if (newIsFinal === "1") {
            $('#toggleBtn').text("MTD");
            $('#selectedDate').hide();
            $('#monthPicker').show();
            datefilter = $('#monthPicker').val();
        } else {
            $('#toggleBtn').text("EOM");
            $('#selectedDate').show();
            $('#monthPicker').hide();
            datefilter = $('#selectedDate').val();
        }
        sendDateData(datefilter, newIsFinal);
    }


    $(document).ready(function () {
        // Daily date picker
        $('#selectedDate').on('change', function () {
            const val = $(this).val();
            $('#hiddenDate').val(val);
            sendDateData(val, "0");
        });

        // Month picker (MM/yyyy)
        $('#monthPicker').on('change', function () {
            const val = $(this).val(); // Format: yyyy-MM
            const [year, month] = val.split('-');
            const lastDay = getLastDayOfMonth(parseInt(year), parseInt(month));
            $('#hiddenDate').val(lastDay);
            sendDateData(lastDay, "1");
        });
    });

    function sendDateData(dateVal, isFinalVal) {
    $.ajax({
        type: "POST",
        url: '@Url.Action("Summary", "Home")',
        data: {
            selectedDate: dateVal,
            isfinal: isFinalVal
        },
        success: function (html) {

            // Parse returned HTML string
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');

            // Replace current body content
            document.body.innerHTML = doc.body.innerHTML;

            // Update title if provided
            if (doc.title) {
                document.title = doc.title;
            }

            // Re-execute scripts from the response
            doc.querySelectorAll('script').forEach(s => {
                const newScript = document.createElement('script');
                if (s.src) {
                    newScript.src = s.src;
                    newScript.async = false; // preserve execution order if needed
                } else {
                    newScript.textContent = s.textContent;
                }
                document.body.appendChild(newScript);
            });
        },
        error: function (err) {
            console.error("AJAX error:", err);
            alert("Failed to load data.");
        }
    });
}
</script>