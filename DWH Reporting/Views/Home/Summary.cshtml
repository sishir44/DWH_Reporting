<script>
    const divs = document.querySelectorAll(".content");
    let currentDiv = 0;
    function showDiv(index) {
        divs.forEach((div, i) => {
            div.style.display = i === index ? "block" : "none";
        });
    }
    function showNextDiv() {

        if (currentDiv === divs.length - 1) {
            // Redirect when next button is clicked on DIV2
            //window.location.href = "http://localhost:52163/Home/EmployeeNumber";
            window.location.href = "https://app.powerbi.com/view?r=eyJrIjoiMGQ3Y2IyN2YtNjc1NC00MDI0LWJmYzUtMzVkNjU4YmQ5ZDc1IiwidCI6IjE5N2FkNTc5LTcwMzctNGIwMC04ZjAxLWQ3MTJkMzZmYTYxZSIsImMiOjl9";
            return;
        }
        if (currentDiv === divs.length - 1) {

            document.getElementById("nextBtn").disabled = true;
            document.getElementById("nextBtn").style.color = 'red';
        }
        if (currentDiv < divs.length - 1) {
            window.location.href = "https://mis.mobilyllc.com/DWHReporting/Home/StoreNo?";
            return;

            document.getElementById("prevBtn").disabled = false;
            document.getElementById("prevBtn").style.color = 'white';
            currentDiv++;
            showDiv(currentDiv);
        }
    }
    function showPrevDiv() {
        if (currentDiv > 0) {
            currentDiv--;
            showDiv(currentDiv);
            // If at the first div, disable the "prev" button
            if (currentDiv === 0) {
                document.getElementById("prevBtn").disabled = true;
                document.getElementById("prevBtn").style.color = 'red';
            }

            // Make sure the "next" button is enabled
            document.getElementById("nextBtn").disabled = false;
            document.getElementById("nextBtn").style.color = 'white';
        }
    }
    ////Initialize by showing the first div
    showDiv(currentDiv);
    document.getElementById("nextBtn").addEventListener("click", showNextDiv);
    document.getElementById("prevBtn").addEventListener("click", showPrevDiv);
</script>
<script>
    // Function to highlight TM and Store cells
    function highlightCells() {
        //GROSS ADDS Goals
        var cells = document.querySelectorAll(".Csatval");

        cells.forEach(function (cell) {
            // Parse the cell's text content as a float
            var value = parseFloat(cell.textContent);

            // Check if the value is greater than 50
            if (!isNaN(value) && value > 70.0) {
                cell.style.backgroundColor = "green";  // Set background color
                cell.style.color = "white";  // Set text color
            }

            // Check if the value is greater than 50
            if (!isNaN(value) && value < 60.0) {
                cell.style.backgroundColor = "yellow";  // Set background color
                cell.style.color = "black";  // Set text color
            }
        });

        //CSAT
        var csat = document.querySelectorAll(".csat");

        csat.forEach(function (cell) {

            var value = parseFloat(cell.textContent);

            if (!isNaN(value) && value > 0.7) {
                cell.style.backgroundColor = "green";
                cell.style.color = "white";
            }

            if (!isNaN(value) && value < 0.7) {
                cell.style.backgroundColor = "yellow";
                cell.style.color = "black";
            }
        });
        //CSAT70
        var CSAT70Cells = document.querySelectorAll(".csat");
        var CSAT70Count = 0;
        CSAT70Cells.forEach(function (cell) {
            var CSAT70Name = cell.textContent.trim();
            if (CSAT70Name < 70) {
                CSAT70Count++;
            }
        });

        document.getElementById("CSAT70").value = CSAT70Count;

        //Above
        var AboveCells = document.querySelectorAll(".csat");
        var AboveCount = 0;
        AboveCells.forEach(function (cell) {
            var AboveName = cell.textContent.trim();
            if (AboveName < 90) {
                AboveCount++;
            }
        });
        document.getElementById("Above").value = AboveCount;

        //Between
        var BetweenCells = document.querySelectorAll(".csat");
        var BetweenCount = 0;
        BetweenCells.forEach(function (cell) {
            var BetweenName = cell.textContent.trim();
            if (BetweenName <= 70) {
                BetweenCount++;
            }
        });
        document.getElementById("Between").value = BetweenCount;


        //Total Stores
        // Select all cells with the 'stores' class
        var storeCells = document.querySelectorAll(".stores");
        var storeCount = 0;

        // Loop through each cell and count if it has a store name
        storeCells.forEach(function (cell) {
            var storeName = cell.textContent.trim();

