<body style="padding-top:0; background-color:#B2D6F2;">

    @*LOADING LOGO*@
    <div id="loadingScreen">
        <img id="loadingLogo" src="https://mis.mobilyllc.com/mobilylogin/image/mobilyloader.gif" alt="Loading Logo">
    </div>

    <div>
        <div id="div1" class="content" style="background-color:#B2D6F2;">
            <div class="row head">
                <div class="col-lg-8 col-md-12 col-sm-12 col-xs-12">
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <h3 style="margin-top:10px; margin-left:50px; font-weight:800; font-size:16px;" class="title">|  MTD Store Summary</h3>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-12 col-sm-12 col-xs-12">
                    <div class="row">
                        @*@{
                                var today = DateTime.Today.ToString("yyyy-MM-dd");
                                var yesterday = DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd");
                            }*@

                        <div class="col-lg-4 col-md-12 col-sm-12 col-xs-12">
                            @using (Html.BeginForm("Summary", "Home", FormMethod.Post))
                            {
                                <div class="form-group">

                                    <!-- Hidden Inputs -->
                                    <input type="hidden" id="isFinal" value="0" />
                                    <input type="hidden" id="hiddenDate" name="selectedDate" />

                                    <!-- Daily Date Picker (Visible initially) -->
                                    <input type="date"
                                           id="selectedDate"
                                           class="form-control"
                                           title="Select Date"
                                           style="width:140px; background-color:#A5CFF0; font-size:12px; font-weight:bold; color:#383b3f; height:40px; border:black;"
                                           onchange="appendUserIDToURL(this.form);"
                                           max="@yesterday" />


                                    <!-- Monthly Picker (Hidden initially) -->
                                    <input type="month"
                                           id="monthPicker"
                                           class="form-control"
                                           title="Select Month"
                                           style="width:140px; background-color:#A5CFF0; font-size:12px; font-weight:bold; color:#383b3f; height:30px; border:black; display:none;" />


                                </div>
                            }
                        </div>
                        <div class="col-lg-2 col-md-12 col-sm-12 col-xs-12">
                            <button type="submit" id="toggleBtn" class="headerbtndiv btn float-right form-control" title="EOM/MTD" onclick="toggleMtdEom()">
                                EOM
                            </button>
                        </div>
                        <div class="col-lg-2 col-md-12 col-sm-12 col-xs-12">
                            <button type="submit" class="headerbtndiv btn float-right form-control" title="First Load Data" id="" onclick="refresh()">
                                <i class="fas fa-retweet"></i>
                            </button>
                        </div>
                        <div class="col-lg-2 col-md-12 col-sm-12 col-xs-12">
                            <button class="headerbtndiv btn float-right form-control" title="Clear Filter" id="clearfilter">
                                <i class="fas fa-filter"></i>
                            </button>
                        </div>
                        <div class="col-lg-2 col-md-12 col-sm-12 col-xs-12">
                            <button class="headerbtndiv btn float-right form-control" title="Export in Excel" onclick="test()">
                                <i class="fas fa-file-excel"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row sub-header">
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6" style="display: flex; color:white; justify-content: flex-start;">
                        <div id="TimeStamp">
                            @if (ViewBag.ReportDate != null)
                            {
                                <p style="margin-bottom: 0rem; font-size: 12px;margin-left:20px;">Report Date: @ViewBag.ReportDate</p>
                            }
                            else
                            {
                                <p style="color: red;">Data not available</p>
                            }
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6" style="display: flex; color:white; justify-content: flex-end;">
                        <div id="LastupdatedOn">
                            @if (ViewBag.LatestTimeStamp != null)
                            {
                                <p style="margin-bottom: 0rem; font-size: 12px;">Update Date & Time: @ViewBag.LatestTimeStamp </p>
                            }
                            else
                            {
                                <p style="color: red;">Data not available</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="fields" style="background-color:white;font-size:8px; overflow-x: auto; white-space: nowrap;">

                <div class="row testimonial-group" style="display: inline-block;">

                    <!-- Budgeted Hours and Total Ops -->
                    @*<div class="col-lg-1 col-md-2 col-sm-12 col-xs-12" style="font-size: 12px; display: inline-block; text-align:center;">
                            <label>Total Stores</label>
                            <input type="button" name="STR" id="storeCountDisplay" class="form-control" value="0"
                                   style="background-color: #31869b; color:white; height: 35px; margin-bottom: 10px;margin-left: 10px;" />

                            <label>Above 100%</label>
                            <input type="button" name="GAtrGoals100" id="GATrGoal100" class="form-control"
                                   value="" title="Above 100%"
                                   style="background-color: green; color:white; height: 35px;margin-left: 10px;margin-bottom: 5px;" />
                        </div>*@
                    <!-- Month and isactive -->
                    @*<div class="col-lg-1 col-md-2 col-sm-12 col-xs-12" style="font-size: 12px; display: inline-block; text-align:center;">
                            <label>Above 70%</label>
                            <input type="button" name="GATrGoal90" id="GATrGoal90" class="form-control"
                                   title="Above 70%"
                                   value=""
                                   style="background-color: red; color:white; height: 35px; margin-bottom: 10px;" />

                            <label>Less Than 70%</label>
                            <input type="button" name="less70" id="GATrGoal70" class="form-control"
                                   title="Gross Adds trend"
                                   value=""
                                   style="background-color: orange; color:white; height: 35px;" />
                        </div>*@



                    <!-- Budgeted Hours and Total Ops -->
                    <div class="col-lg-1 col-md-2 col-sm-12 col-xs-12" style="font-size: 12px; display: inline-block; text-align:center;">
                        <div class="maindiv">
                            <label>Total Stores</label>
                            <input type="button" name="GAGoals" id="storeCountDisplay" class="form-control" value="0"
                                   style="background-color:#31869b;  color:white; font-size: 10px; height: 20px; margin-bottom: 10px;padding: 0px 0 !important;" />

                            <label>100% & Above</label>
                            <input type="button" name=">100" id="GATrGoal100" class="form-control"
                                   title="100% & Above" value=""
                                   style="background-color: green;  color:white; font-size: 10px; height: 20px; margin-bottom: 10px;padding: 0px 0 !important;" />
                        </div>
                    </div>

                    <!-- Month and isactive -->
                    <div class="col-lg-1 col-md-2 col-sm-12 col-xs-12" style="font-size: 12px; display: inline-block; text-align:center;">
                        <div class="maindiv">
                            <label>70% & Above</label>
                            <input type="button" name=">70" id="GATrGoal90" class="form-control"
                                   title="70% & Above"
                                   value=""
                                   style="background-color: orange; color: white; font-size: 10px; height: 20px; margin-bottom: 10px; padding: 0px 0 !important;" />

                            <label>Less Than 70%</label>
                            <input type="button" name="<70" id="GATrGoal70" class="form-control"
                                   title="Less Than 70%"
                                   value=""
                                   style="background-color: red;  color:white;font-size: 10px; height: 20px; margin-bottom: 10px;padding: 0px 0 !important;" />
                        </div>
                    </div>


                    <!-- Search TM -->
                    <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12" style="display: inline-block; vertical-align: top;">
                        <input type="text" name="textSearchTM" id="textSearchTM" class="selectorinput form-control" placeholder="Search TM" onkeyup="TMFilter()" />
                        <select class="form-control selector" id="TM" multiple onchange="filterTMData(event)">
                            @if (ViewBag.TMList != null && ViewBag.TMList.Count > 0)
                            {
                                foreach (var item in ViewBag.TMList)
                                {
                                    <option class="optionfilter" style="border-radius: 6px; background-color:#3A75D0; text-align: center; color: white; margin-bottom: 5px; font-size: 10px;" value="@item.Value">@item.Text</option>
                                }
                            }
