    function filterStoresData(event) {
        debugger;

        // Get the Stores select element
        var storesSelect = document.getElementById('Stores');

        // Get the text of the last clicked option
        var clickedOptionText = event
            ? event.target.options[event.target.selectedIndex].text
            : (storesSelect.selectedOptions.length > 0 ? storesSelect.selectedOptions[0].text : '');

        // All selected values
        var selectedValues = Array.from(storesSelect.selectedOptions).map(option => option.value);

        // Filter table rows manually
        document.querySelectorAll('#tbl tbody tr').forEach(row => {
            var storeValue = row.getAttribute('data-store');
            if (row.classList.contains('total_data')) {
                row.style.display = '';
            } else if (selectedValues.length === 0 || selectedValues.includes(storeValue)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });

        // Search filter input
        var input = document.getElementById('textSearchStores').value.toUpperCase();

        // Apply DataTables filter if initialized
        if ($.fn.dataTable && $.fn.dataTable.isDataTable('#tbl')) {
            $.fn.dataTable.ext.search = []; // clear old filters
            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                var rowContent = data.join(' ').toUpperCase();
                var row = $('#tbl tbody tr').eq(dataIndex);
                if (row.hasClass('total_data')) {
                    return true;
                }
                return rowContent.indexOf(input) > -1 || input === '';
            });
            $('#tbl').DataTable().draw();
        }

        // Get all related selects
        var tmSelect = document.getElementById('TM');
        var marketSelect = document.getElementById('Market');
        var tiersSelect = document.getElementById('Tiers');
        var sdSelect = document.getElementById('SD');

        // Apply dependent filters based on disabled states
        if (tmSelect.disabled && marketSelect.disabled) {
            STRfilterStoresOptions(selectedValues);
            STRfilterTiersOptions(selectedValues);
            STRfilterSDOptions(selectedValues);
            storesSelect.disabled = true;
            $('tr.filter_data').remove();
            loadGTotalByFilter(tmSelect.innerText, marketSelect.innerText, null, clickedOptionText, null);

        } else if (tmSelect.disabled) {
            STRfilterMarketOptions(selectedValues);
            STRfilterStoresOptions(selectedValues);
            STRfilterTiersOptions(selectedValues);
            STRfilterSDOptions(selectedValues);
            marketSelect.disabled = true;
            storesSelect.disabled = true;
            $('tr.filter_data').remove();
            loadGTotalByFilter(tmSelect.innerText, marketSelect.innerText, null, clickedOptionText, null);

        } else if (marketSelect.disabled) {
            STRfilterTMOptions(selectedValues);
            STRfilterStoresOptions(selectedValues);
            STRfilterTiersOptions(selectedValues);
            STRfilterSDOptions(selectedValues);
            tmSelect.disabled = true;
            storesSelect.disabled = true;
            $('tr.filter_data').remove();
            loadGTotalByFilter(tmSelect.innerText, marketSelect.innerText, null, clickedOptionText, null);

        } else {
            STRfilterTMOptions(selectedValues);
            STRfilterMarketOptions(selectedValues);
            STRfilterStoresOptions(selectedValues);
            STRfilterTiersOptions(selectedValues);
            STRfilterSDOptions(selectedValues);
            tmSelect.disabled = true;
            marketSelect.disabled = true;
            storesSelect.disabled = true;
            tiersSelect.disabled = true;
            $('tr.filter_data').remove();
            loadGTotalByFilter(tmSelect.innerText, marketSelect.innerText, null, clickedOptionText, null);
        }
    }

    function STRfilterTMOptions(selectedValues) {
        var TMSelect = document.getElementById('TM');
        // Clear the TM dropdown
        TMSelect.innerHTML = '';

        // Get all visible table rows after the SD filter
        var filteredRows = Array.from(document.querySelectorAll('#tbl tbody tr'))
            .filter(row => row.style.display !== 'none' && selectedValues.includes(row.getAttribute('data-Store')));

        // Collect all unique TM values from the filtered rows
        var availableTM = new Set();
        filteredRows.forEach(row => {

            var TMValue = row.getAttribute('data-tm');
            if (TMValue) {
                availableTM.add(TMValue);
            }
        });

        // If any SD is selected, disable the TM dropdown but populate with matching options
        if (selectedValues.length > 0) {
            //TMSelect.disabled = true;  // Keep the dropdown disabled if required

            // Populate the TM dropdown with only the TM from filtered rows
            availableTM.forEach(TMValue => {
                var option = document.createElement('option');
                option.value = TMValue;
                option.text = TMValue;
                option.style.color = 'grey';  // Highlight in red (optional)
                option.style.fontSize = '10px';
                TMSelect.add(option);
            });
        } else {
            // If no SD is selected, enable the TM dropdown and reset all options
            //TMSelect.disabled = false;

            // Optionally, repopulate with all TM (e.g., from original ViewBag or data source)
            var allRows = document.querySelectorAll('#tbl tbody tr');
            allRows.forEach(row => {
                var TMValue = row.getAttribute('data-tm');
                if (TMValue) {
                    var option = document.createElement('option');
                    option.value = TMValue;
                    option.text = TMValue;
                    TMSelect.add(option);
                }
            });
        }
    }

