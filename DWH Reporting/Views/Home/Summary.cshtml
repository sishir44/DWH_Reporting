            <div class="table-responsive" id="printtable">
                <div id="imageloader2" style="padding-left: 543px;"></div>
                <div id="demoDW">
                    <div id="myDiv">
                        <table id="tbl" style="border-collapse: collapse; white-space:nowrap;">
                            <thead>
                                @functions {
                                    // Helper method to convert number to corresponding alphabet(s)
                                    public static string GetAlphabetFromNumber(int number)
                                    {
                                        string result = string.Empty;
                                        while (number > 0)
                                        {
                                            number--; // Decrement to handle 1-based indexing
                                            result = (char)('A' + (number % 26)) + result;
                                            number /= 26;
                                        }
                                        return result;
                                    }
                                }
                                <tr class="numbered_header">
                                    @for (int i = 1; i <= 77; i++) // Loop from 1 to 164
                                    {
                                        <th style="font-size:8px; background-color: lightgray; color:black; text-align:center;">@GetAlphabetFromNumber(i)</th>
                                    }
                                </tr>
                                <tr class="spanned_header">
                                    <th rowspan="2" style="background-color: black; color:white;">Market</th>
                                    <th rowspan="2" style="background-color: black; color:white;">TM</th>
                                    <th rowspan="2" style="background-color: black; color:white;">Store</th>
                                    <th rowspan="2" style="background-color: black; color:white;">Store Contact</th>
                                    @*<th id="ColSpan78" colspan="75">
                                        </th>*@
                                </tr>
                                <tr class="main_header">
                                    <td>Monthly<br>Achived Hours<br>Trending % </td>
                                    <td>Weekly<br>Budgeted<br>HRS</td>
                                    <td>GROSS ADDS<br>Trend%<br> To Goal</td>
