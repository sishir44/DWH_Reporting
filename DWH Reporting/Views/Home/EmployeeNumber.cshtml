<script>
    const divs = document.querySelectorAll(".content");
    let currentDiv = 0;
    function showDiv(index) {
        divs.forEach((div, i) => {
            div.style.display = i === index ? "block" : "none";
        });
    }

    function showNextDiv() {
        if (currentDiv === divs.length - 1) {
            document.getElementById("nextBtn").disabled = true;
            document.getElementById("nextBtn").style.color = 'red';
        }

        if (currentDiv < divs.length - 1) {
            document.getElementById("prevBtn").disabled = false;
            document.getElementById("prevBtn").style.color = 'white';
            currentDiv++;
            showDiv(currentDiv);
        }
    }

    function showPrevDiv() {
        if (currentDiv > 0) {
            currentDiv--;
            showDiv(currentDiv);
            // If at the first div, disable the "prev" button
            if (currentDiv === 0) {
                document.getElementById("prevBtn").disabled = true;
                document.getElementById("prevBtn").style.color = 'red';
            }

            // Make sure the "next" button is enabled
            document.getElementById("nextBtn").disabled = false;
            document.getElementById("nextBtn").style.color = 'white';
        }
    }

    // Initialize by showing the first div
    showDiv(currentDiv);

    document.getElementById("nextBtn").addEventListener("click", showNextDiv);
    document.getElementById("prevBtn").addEventListener("click", showPrevDiv);
</script>
<script>
    // Function to highlight TM and Store cells
    function highlightCells() {
        // Get the table element
        var table = document.getElementById("tbl");

        // Loop through all rows with the class 'main_data'
        var rows = document.getElementsByClassName("main_data");
        for (var i = 0; i < rows.length; i++) {
            // Get the TM cell (10th column in the row)
            var gatgCell = rows[i].cells[15];
            // Get the Store cell (7th column in the row)
            var storeCell = rows[i].cells[6];

            var dCell = rows[i].cells[13];

            // Get the TM value and convert it to a number by removing the $ sign
            //var gatgCell = parseFloat(gatgCell.innerText.replace('$', ''));
            //var gatgCell = parseFloat(gatgCell.innerText.match(/[0-9,.]+/)[0]);
            var gatgCellv = parseFloat(gatgCell.innerText);


            // If the TM value is greater than 20, change the background color to yellow and font color to white
            if (gatgCellv > 20) {
                gatgCell.style.backgroundColor = "green";  // Set background color to green
                gatgCell.style.color = "white";  // Set font color to white
            }
            // Check if the Store value contains a comma
            if (storeCell.innerText.includes('-')) {
                storeCell.style.backgroundColor = "orange";  // Set background color to yellow
                storeCell.style.color = "white";  // Set font color to white
            }
        }
    }

    // Call the function to apply the highlighting
    highlightCells();
</script>
<script>
    function filterVPData() {
        // Get selected VP values from the dropdown
        var selectedValues = Array.from(document.getElementById('VP').selectedOptions).map(option => option.value);

        // Get all rows in the table
        var rows = document.querySelectorAll('#tbl tbody tr');

        // Loop through each row and check if the VP column matches the selected values
        rows.forEach(row => {
            var vpValue = row.getAttribute('data-vp');

            // Check if this row is the "Grand Total" row
            if (row.classList.contains('total_data')) {
                row.style.display = '';  // Always show the "Grand Total" row
            } else if (selectedValues.length === 0 || selectedValues.includes(vpValue)) {
                row.style.display = '';  // Show row if VP matches or if no VP is selected
            } else {
                row.style.display = 'none';  // Hide row if VP does not match
            }
        });

        // Now handle the search input filter for DataTables
        var input = document.getElementById('textSearchVP').value.toUpperCase();

        // Use the DataTables custom filter API
        $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
            var rowContent = data.join(' ').toUpperCase();

            // Check if the row contains the input
            var row = $('#tbl tbody tr').eq(dataIndex);

            // Always return true for the "Grand Total" row
            if (row.hasClass('total_data')) {
                return true;  // Always show the "Grand Total" row
            }

            // If the row contains the input, return true to keep it visible
            return rowContent.indexOf(input) > -1 || input === '';
        });

        // Redraw the table with the new search criteria
        $('#tbl').DataTable().draw();

        // Remove the custom search after use to avoid stacking filters
        $.fn.dataTable.ext.search.pop();
    }
