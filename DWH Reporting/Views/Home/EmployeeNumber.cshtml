    ////////////////VP Hierarchy////////////////////////////
    function filterVPData() {
        // Get selected VP values from the dropdown
        var selectedValues = Array.from(document.getElementById('VP').selectedOptions).map(option => option.value);

        // Get all rows in the table
        var rows = document.querySelectorAll('#tbl tbody tr');
        var totalCSAT = 0;  // Initialize CSAT total
        var totalBHRS = 0;

        // Loop through each row and check if the VP column matches the selected values
        rows.forEach(row => {
            var VPValue = row.getAttribute('data-vp');
            var csatValue = parseFloat(row.getAttribute('data-csat')) || 0;  // Get the CSAT value from data-csat attribute
            var bhrsValue = parseFloat(row.getAttribute('data-bhrs')) || 0;


            // Check if this row is the "Grand Total" row
            if (row.classList.contains('total_data')) {
                row.style.display = '';  // Always show the "Grand Total" row
            } else if (selectedValues.length === 0 || selectedValues.includes(VPValue)) {
                row.style.display = '';  // Show row if VP matches or if no VP is selected

                totalCSAT += csatValue;  // Sum the CSAT value for visible rows
                totalBHRS += bhrsValue;

            } else {
                row.style.display = 'none';  // Hide row if VP does not match
            }
        });

        // Handle the search input filter for DataTables
        var input = document.getElementById('textSearchVP').value.toUpperCase();

        // Use the DataTables custom filter API
        $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
            var rowContent = data.join(' ').toUpperCase();

            // Check if the row contains the input
            var row = $('#tbl tbody tr').eq(dataIndex);

            // Always return true for the "Grand Total" row
            if (row.hasClass('total_data')) {
                return true;  // Always show the "Grand Total" row
            }

            // If the row contains the input, return true to keep it visible
            return rowContent.indexOf(input) > -1 || input === '';
        });

        // Redraw the table with the new search criteria
        $('#tbl').DataTable().draw();

        // Remove the custom search after use to avoid stacking filters
        $.fn.dataTable.ext.search.pop();

        //Hierarchy Now handle disabling and filtering the others dropdowns
        VPfilterRegionOptions(selectedValues);
        VPfilterVPOptions(selectedValues);
        VPfilterSDOptions(selectedValues);
        VPfilterTiersOptions(selectedValues);
        VPfilterStoresOptions(selectedValues);
        VPfilterMarketOptions(selectedValues);
        VPfilterTMOptions(selectedValues);

        // Set the value of the input button to display the total CSAT
        document.getElementById('csatTotal').value = totalCSAT.toFixed(1);
        document.getElementById('bhrsTotal').value = totalBHRS.toFixed(1);

    }
    function VPfilterVPOptions(selectedValues) {
        var vpSelect = document.getElementById('VP');
        // Clear the Vp dropdown
        vpSelect.innerHTML = '';

        // Get all visible table rows after the SD filter
        var filteredRows = Array.from(document.querySelectorAll('#tbl tbody tr'))
            .filter(row => row.style.display !== 'none' && selectedValues.includes(row.getAttribute('data-vp')));

        // Collect all unique vp values from the filtered rows
        var availableVp = new Set();
        filteredRows.forEach(row => {

            var vpValue = row.getAttribute('data-vp');
            if (vpValue) {
                availableVp.add(vpValue);
            }
        });

        // If any SD is selected, disable the Vp dropdown but populate with matching options
        if (selectedValues.length > 0) {
            vpSelect.disabled = true;  // Keep the dropdown disabled if required

            // Populate the Vp dropdown with only the vps from filtered rows
            availableVp.forEach(vpValue => {
                var option = document.createElement('option');
                option.value = vpValue;
                option.text = vpValue;
                option.style.color = 'grey';  // Highlight in red (optional)
                vpSelect.add(option);
            });
        } else {
            // If no SD is selected, enable the Vp dropdown and reset all options
            vpSelect.disabled = false;

            // Optionally, repopulate with all vps (e.g., from original ViewBag or data source)
            var allRows = document.querySelectorAll('#tbl tbody tr');
            allRows.forEach(row => {
                var vpValue = row.getAttribute('data-vp');
                if (vpValue) {
                    var option = document.createElement('option');
                    option.value = vpValue;
                    option.text = vpValue;
                    vpSelect.add(option);
                }
            });
        }
    }
