                                    <option style="font-size:12px; background-color:lightblue; color:black; border-radius: 7px; padding: 5px 0; margin-bottom: 3px;" value="@item.Value">@item.Text</option>
                                }
                            }
                            else
                            {
                                <option style="font-size:12px; background-color:lightblue; color:black; border-radius: 7px;" disabled>No VP available</option>
                            }
