    function STRfilterTMOptions(selectedValues) {
        var TMSelect = document.getElementById('TM');
        // Clear the TM dropdown
        TMSelect.innerHTML = '';

        // Get all visible table rows after the SD filter
        var filteredRows = Array.from(document.querySelectorAll('#tbl tbody tr'))
            .filter(row => row.style.display !== 'none' && selectedValues.includes(row.getAttribute('data-Store')));

        // Collect all unique TM values from the filtered rows
        var availableTM = new Set();
        filteredRows.forEach(row => {

            var TMValue = row.getAttribute('data-tm');
            if (TMValue) {
                availableTM.add(TMValue);
            }
        });

        // If any SD is selected, disable the TM dropdown but populate with matching options
        if (selectedValues.length > 0) {
            //TMSelect.disabled = true;  // Keep the dropdown disabled if required

            // Populate the TM dropdown with only the TM from filtered rows
            availableTM.forEach(TMValue => {
                var option = document.createElement('option');
                option.value = TMValue;
                option.text = TMValue;
                option.style.color = 'grey';  // Highlight in red (optional)
                option.style.fontSize = '10px';
                TMSelect.add(option);
            });
        } else {
            // If no SD is selected, enable the TM dropdown and reset all options
            //TMSelect.disabled = false;

            // Optionally, repopulate with all TM (e.g., from original ViewBag or data source)
            var allRows = document.querySelectorAll('#tbl tbody tr');
            allRows.forEach(row => {
                var TMValue = row.getAttribute('data-tm');
                if (TMValue) {
                    var option = document.createElement('option');
                    option.value = TMValue;
                    option.text = TMValue;
                    TMSelect.add(option);
                }
            });
        }
    }
