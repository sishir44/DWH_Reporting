    function clearFilter(){

        // Clear the selected options in all the dropdowns
        document.getElementById('VP').selectedIndex = -1;
        document.getElementById('Region').selectedIndex = -1;
        document.getElementById('SD').selectedIndex = -1;
        document.getElementById('Tiers').selectedIndex = -1;
        document.getElementById('Stores').selectedIndex = -1;
        document.getElementById('Market').selectedIndex = -1;
        document.getElementById('TM').selectedIndex = -1;

        document.getElementById('csatTotal').value = @String.Format("{0:N1}", Convert.ToDouble(@ViewBag.CSAT));
        document.getElementById('bhrsTotal').value = @ViewBag.ActualBudHRS

        // Use DataTables API to clear filters and show all rows
        var table = $('#tbl').DataTable();
        table.search('').columns().search('').draw();  // Clear any global or column-specific filters

        // Show all the rows in the table
        var rows = document.querySelectorAll('#tbl tbody tr');
        rows.forEach(row => {
            row.style.display = ''; // Show all rows
        });

        ////////////////////////////////
        // Restore the all dropdown to its original state
        resetRegionDropdown();
        resetVPDropdown();
        resetSDDropdown();
        resetTIERSDropdown();
        resetStoresDropdown();
        resetMarketDropdown();
        resetTMDropdown();

        // Use the DataTables custom filter API to clear any search
        $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
            var rowContent = data.join(' ').toUpperCase();

            // Check if the row contains the input
            var row = $('#tbl tbody tr').eq(dataIndex);

            // Always return true for the "Grand Total" row
            if (row.hasClass('total_data')) {
                return true;  // Always show the "Grand Total" row
            }

            // If the row contains the input, return true to keep it visible
            return rowContent.indexOf(input) > -1 || input === '';
        });

        // Redraw the table with the new search criteria
        $('#tbl').DataTable().draw();

        // Remove the custom search after use to avoid stacking filters
        $.fn.dataTable.ext.search.pop();
    }
