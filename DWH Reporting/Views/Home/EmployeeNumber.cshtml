    function takeshot() {
        //window.print();

        // Get the content of the div
        var divContents = document.getElementById("myDiv").innerHTML;
        // Open a new window
        var printWindow = window.open('', '', 'height=500, width=800');
        // Write the content into the new window
        printWindow.document.write('<html><head><title>Print Div</title>');
        printWindow.document.write('</head><body >');
        printWindow.document.write(divContents);
        printWindow.document.write('</body></html>');
        // Close the document to render the content
        printWindow.document.close();
        // Wait for the content to load and then call the print function
        printWindow.onload = function () {
            printWindow.focus(); // Required for IE and some browsers
            printWindow.print();
            printWindow.close();
        };
    }

    function printTable() {
        //Hide all unnecessary elements by adding a 'print-hidden' class
        var elementsToHide = document.querySelectorAll('header, footer, .sidebar, .navbar, .other-section'); // Customize this to the elements you want hidden
        elementsToHide.forEach(function (el) {
            el.style.display = 'none';
        });

        // Temporarily show only the table
        var table = document.getElementById("tbl");
        table.style.display = 'table'; // Ensure the table is displayed

        // Open the print dialog
        window.print();

        // Restore visibility of previously hidden elements
        elementsToHide.forEach(function (el) {
            el.style.display = ''; // Restore to default
        });
    }

    function printFullTable() {
        var tableContent = document.getElementById('tbl').outerHTML;
        var originalContents = document.body.innerHTML;

        document.body.innerHTML = tableContent;

        window.print();

        document.body.innerHTML = originalContents;
    }

