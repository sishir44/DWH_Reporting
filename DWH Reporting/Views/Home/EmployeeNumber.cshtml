                            {
                                <p>Update Date & Time: @ViewBag.LatestTimeStamp </p>
                            }
                            else
                            {
                                <p style="color: red;">Data not available</p>
                            }
                        </div>

                    </div>
                </div>
            </div>
            <div class="fields" style="background-color:white;  overflow-x: auto; white-space: nowrap;">
                <div class="row testimonial-group" style="display: inline-block;">
                    <!-- Actual Hours and Total Ops -->
                    <div class="col-lg-1 col-md-2 col-sm-12 col-xs-12" style="font-size: 12px; display: inline-block; text-align:center; vertical-align: central;">
                        <div class="Indicators">
                            <label>Budgeted Hours</label>

                            <input type="button" name="StoresCount" id="bhrsTotal" class="form-control"
                                   value=@String.Format("{0:N1}", Convert.ToDouble(@ViewBag.ActualBudHRS)) title="Above 100%"
                                   style="background-color: white; color:black;" />
                            <br />

                            <label>Total Ops</label>
                            <input type="button" name="above90" id="above90" class="form-control"
                                   value="@ViewBag.TotalOps" title="Above 100%"
                                   style="background-color: green; color:white;" />
                        </div>
                    </div>
                    <!-- Month and isactive -->
                    <div class="col-lg-1 col-md-2 col-sm-12 col-xs-12" style="font-size: 12px; display: inline-block; text-align:center; vertical-align: central;">
                        <label>Month</label>
                        @using (Html.BeginForm("EmployeeNumber", "Home", FormMethod.Get))
                        {
                            <div class="form-group">
                                @if (ViewBag.Months != null && ((IEnumerable<SelectListItem>)ViewBag.Months).Any())
                                {
                                    // Render the dropdown list if Months is not null and has items
                                    @Html.DropDownList(
                                        "selectedMonth",
                                        new SelectList(ViewBag.Months, "Value", "Text"),
                                        "Select",
                                        new
                                        {
                                            @class = "form-control",
                                            style = "background-color:#A5CFF0; font-size: 14px; font-weight: bold; color:#0C5D0C; border:black",
                                            onchange = "this.form.submit();"
                                        }
                                    )
                                }
                                else
                                {
                                    // Display a message if Months is null or empty
                                    <p>No months selected!</p>
                                }
                            </div>
                        }

                        <label style=" margin-top: 10px;">CSAT</label>
                        <input type="button" name="above90" id="csatTotal" class="form-control"
                               title="CSAT"
                               value=@String.Format("{0:N1}", Convert.ToDouble(@ViewBag.CSAT))
                               style="background-color: orange; color:white;" />

                    </div>
                    <!-- Search VP -->
