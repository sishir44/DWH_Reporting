    function mmmFilter() {
        // Optional: If you want to add the text search functionality too, you can implement it here
        var input = document.getElementById('textSearchMULMngr').value.toUpperCase();
        var rows = document.querySelectorAll('#tbl tbody tr');

        rows.forEach(row => {
            var mmmValue = row.getAttribute('data-mmm'); // Get the Market value from the row's data attribute
            if (mmmValue.toUpperCase().indexOf(input) > -1 || input === '') {
