<body style="padding-top:0; background-color:#B2D6F2;">

    <!-- LOADING LOGO -->
    <div id="loadingScreen">
        <img id="loadingLogo" src="~/Image/spinner-8565_256.gif" alt="Loading Logo">
    </div>

    <div>
        <div id="div1" class="content" style="background-color:#B2D6F2;">

            <!-- TITLE & DATE FILTER & EXPORT BTN-->
            <div class="row head">
                <div class="col-lg-6 col-md-12 col-sm-12 col-xs-12">
                    <div class="row">
                        <div class="col-lg-2 col-md-12 col-sm-12 col-xs-12">
                            @*<img src="~/Image/smLogoMobily.png" />*@
                        </div>
                        <div class="col-lg-10 col-md-12 col-sm-12 col-xs-12">
                            <h3 style="margin-top:6px; font-weight:800; font-size:20px;" class="title">|  MTD @ViewBag.Title</h3>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 col-md-12 col-sm-12 col-xs-12">
                    <div class="row">
                        @{
                            var today = DateTime.Today.ToString("yyyy-MM-dd");
                            var yesterday = DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd");
                        }

                        <div class="col-lg-4 col-md-12 col-sm-12 col-xs-12">
                            @using (Html.BeginForm("EmployeeNumber", "Home", FormMethod.Get))
                            {
                                <div class="form-group">
                                    <input type="date"
                                           id="selectedDate"
                                           name="selectedDate"
                                           class="form-control"
                                           title="Select Date"
                                           style="margin-top:8px; background-color:#A5CFF0; font-size: 14px; font-weight: bold; color:#0C5D0C; border:black"
                                           onchange="this.form.submit();"
                                           max="@yesterday" /> <!-- Disable today and future dates -->
                                </div>
                            }
                        </div>
                        <div class="col-lg-2 col-md-12 col-sm-12 col-xs-12">
                            @using (Html.BeginForm("EmployeeNumber", "Home", FormMethod.Get))
                            {
                                <button type="submit" class="headerbtndiv btn float-right form-control" title="First Load Data" id="resetid">
                                    <i class="fas fa-retweet"></i>
                                </button>
                            }

                        </div>
                        <div class="col-lg-2 col-md-12 col-sm-12 col-xs-12">
                            <button class="headerbtndiv btn float-right form-control" title="Clear Filter" id="clearfilter" onclick="clearfilter()">
                                <i class="fas fa-filter"></i>
                            </button>
                        </div>
                        <div class="col-lg-2 col-md-12 col-sm-12 col-xs-12">
                            <button class="headerbtndiv btn float-right form-control" title="Export in Excel" onclick="test()">

                                <i class="fas fa-file-excel"></i>

                            </button>
                        </div>
                        <div class="col-lg-2 col-md-12 col-sm-12 col-xs-12">
                            <button class="headerbtndiv btn float-right form-control" title="Print" onclick="printTable()">
                                <i class="fas fa-print"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- UPDATED RPT DATE -->
            <div class="row sub-header" style="background-color: grey;width: 100%;margin: 0 auto;">
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6" style="display: flex; color:white; justify-content: flex-start;">
                        <div id="TimeStamp">
                            @if (ViewBag.ReportDate != null)
                            {
                                <p style="margin-bottom: 0rem; font-size: 12px; margin-left:20px;">Report Date: @ViewBag.ReportDate</p>
                            }
                            else
                            {
                                <p style="color: red;">Data not available</p>
                            }
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6" style="display: flex; color:white; justify-content: flex-end;">
                        <div id="LastupdatedOn">
                            @if (ViewBag.LatestTimeStamp != null)
                            {
                                <p style="margin-bottom: 0rem; font-size: 12px;">Update Date & Time: @ViewBag.LatestTimeStamp </p>
                            }
                            else
                            {
                                <p style="color: red;">Data not available</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- FILTERS -->
            <div class="fields" style="background-color:white; font-size:8px; overflow-x: auto; white-space: nowrap;">

                <div class="row testimonial-group" style="display: inline-block;">

                    <!-- Budgeted Hours and Total Ops -->
                    <div class="col-lg-1 col-md-2 col-sm-12 col-xs-12" style="font-size: 12px; display: inline-block; text-align:center;">
                        <label>Total Stores</label>
                        <input type="button" name="STR" id="storeCountDisplay" class="form-control" value="0"
                               style="background-color: #31869b; color:white; height: 35px; margin-bottom: 10px; margin-left:10px;" />

                        <label>100% & Above</label>
                        <input type="button" name="OPS" id="tbeCountDisplay" class="form-control"
                               title="Above 100%" value=""
                               style="background-color: green; color:white; height: 35px; margin-left:10px; margin-bottom:5px;" />
                    </div>

                    <!-- Month and isactive -->
                    <div class="col-lg-1 col-md-2 col-sm-12 col-xs-12" style="font-size: 12px; display: inline-block; text-align:center;">
                        <label>Above 70%</label>
                        <input type="button" name="above90" id="tbeCountDisplay70" class="form-control"
                               title="Traffic"
                               value=""
                               style="background-color: deeppink; color:white; height: 35px; margin-bottom: 10px;" />

                        <label>Less Than 70%</label>
                        <input type="button" name="above90" id="tbeCountDisplay90" class="form-control"
                               title="CSAT"
                               value=""
                               style="background-color: orange; color:white; height: 35px; margin-bottom:5px;" />
                    </div>

                    <!-- Search TM -->
                    <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12" style="display: inline-block; vertical-align: top;">
                        <input type="text" name="textSearchTM" id="textSearchTM" class="selectorinput form-control" placeholder="Search TM" />
                        <select class="form-control selector" id="TM" multiple onchange="filterTMData()">
                            @if (ViewBag.TMList != null && ViewBag.TMList.Count > 0)
                            {
                                foreach (var item in ViewBag.TMList)
                                {
                                    <option style="border-radius: 6px; background-color:#3A75D0; text-align: center; color: white; margin-bottom: 5px; font-size: 10px;" value="@item.Value">@item.Text</option>
                                }
                            }
                            else
                            {
                                <option style="font-size:12px; background-color:lightblue; color:black; border-radius: 6px;" disabled>No TM available</option>
                            }
                        </select>
                    </div>

                    <!-- Search Market -->
                    <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12" style="display: inline-block; vertical-align: top;">
                        <input type="text" name="textSearchMarket" id="textSearchMarket" class="selectorinput form-control" placeholder="Search Market" />
                        <select class="form-control selector" id="Market" multiple onchange="filterMarketData()">
                            @if (ViewBag.MarketList != null && ViewBag.MarketList.Count > 0)
                            {
                                foreach (var item in ViewBag.MarketList)
                                {
                                    <option style="border-radius: 6px; background-color:#3A75D0; text-align: center; color: white; margin-bottom: 5px; font-size: 10px;" value="@item.Value">@item.Text</option>
                                }
                            }
                            else
                            {
                                <option style="font-size:12px; background-color:lightblue; color:black; border-radius: 7px;" disabled>No Market available</option>
                            }
                        </select>
                    </div>

                    <!-- Search Stores -->
                    <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12" style="display: inline-block; vertical-align: top;">
                        <input type="text" name="textSearchStores" id="textSearchStores" class="selectorinput form-control" placeholder="Search Stores" />
                        <select class="form-control selector" id="Stores" multiple onchange="filterStoresData()">
                            @if (ViewBag.StoresList != null && ViewBag.StoresList.Count > 0)
                            {
                                foreach (var item in ViewBag.StoresList)
                                {
                                    <option style="border-radius: 6px; background-color:#3A75D0; text-align: center; color: white; margin-bottom: 5px; font-size: 10px;" value="@item.Value">@item.Text</option>
                                }
                            }
                            else
                            {
                                <option style="font-size:12px; background-color:lightblue; color:black; border-radius: 7px;" disabled>No Stores available</option>
                            }
                        </select>

                    </div>

                    <!-- Search Tiers -->
                    <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12" style="display: inline-block; vertical-align: top;">
                        <input type="text" name="textSearchTiers" id="textSearchTiers" class="selectorinput form-control" placeholder="Search Tiers" />
                        <select class="form-control selector" id="Tiers" multiple onchange="filterTiersData()">
                            @if (ViewBag.tiersList != null && ViewBag.tiersList.Count > 0)
                            {
                                foreach (var item in ViewBag.tiersList)
                                {
                                    <option style="border-radius: 6px; background-color:#3A75D0; text-align: center; color: white; margin-bottom: 5px; font-size: 10px;" value="@item.Value">@item.Text</option>
                                }
                            }
                            else
                            {
                                <option style="font-size:12px; background-color:lightblue; color:black; border-radius: 7px; " disabled>No Tiers available</option>
                            }
                        </select>
                    </div>

                </div>

            </div>

            <div id="myDiv">
                <table id="tbl" style="border-collapse: collapse; white-space:nowrap;">
                    <thead>
                        @functions {
                            // Helper method to convert number to corresponding alphabet(s)
                            public static string GetAlphabetFromNumber(int number)
                            {
                                string result = string.Empty;
                                while (number > 0)
                                {
                                    number--; // Decrement to handle 1-based indexing
                                    result = (char)('A' + (number % 26)) + result;
                                    number /= 26;
                                }
                                return result;
                            }
                        }

                        <tr class="numbered_header">
                            @for (int i = 1; i <= 154; i++)
                            {
                                <th style="font-size:8px; background-color: #E6E6E6; color:black; text-align:center;">@GetAlphabetFromNumber(i)</th>
                            }
                        </tr>

                        <tr class="spanned_header">
                            @*<th rowspan="2" style="background-color: black; color:white;">Region</th>
                                <th rowspan="2" style="background-color: black; color:white;">SD</th>*@
                            <th rowspan="2" style="background-color: black; color:white; white-space: normal; word-wrap: break-word;">Store</th>
                            <th rowspan="2" style="background-color: black; color:white; white-space: normal; word-wrap: break-word;">TM</th>
                            <th rowspan="2" style="background-color: black; color:white; white-space: normal; word-wrap: break-word;">Market</th>
                            @*<th rowspan="2" style="background-color: black; color:white;">MMM</th>*@
                            <th rowspan="2" style="background-color: black; color:white;">Unique ID</th>
                            <th rowspan="2" style="background-color: black; color:white;">Dealer Code</th>
                            <th rowspan="2" style="background-color: black; color:white;">Emp ID  (Paycom)</th>
                            <th rowspan="2" style="background-color: black; color:white;">Employees</th>
                            <th rowspan="2" style="background-color: black; color:white;">Role</th>
