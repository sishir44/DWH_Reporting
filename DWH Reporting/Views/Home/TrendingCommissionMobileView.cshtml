            function percentageWithRoundWhole(val1, val2) {
                try {
                    var result;
                    if (val2 != 0) {
                        result = Math.round((val1 / val2) * 100);
                    }
                    else {
                        result = 0;
                    }
                    return result;
                } catch (e) {
                    alert(e.message);
                }
            };
            function Trending_Percentage(val1, TrendingDays, WorkingDays, val2) {
                try {
                    var result;
                    if (val2 != 0 && val1 != 0) {
                        result = (((val1 / TrendingDays) * WorkingDays) / val2).toFixed(2);
                    }
                    else {
                        result = 0;
                    }
                    return result;
                } catch (e) {
                    alert(e.message);
                }
            };
            function divide(val1, val2) {
                try {
                    var result;
                    if (val2 != 0) {
                        result = val1 / val2
                    }
                    else {
                        result = 0;
                    }
                    return result;
                } catch (e) {
                    alert(e.message);
                }
            };
