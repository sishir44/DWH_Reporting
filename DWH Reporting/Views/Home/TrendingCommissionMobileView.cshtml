
@{
    ViewBag.Title = "TrendingCommissionMobileView";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>@ViewBag.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="apple-touch-icon" href="https://mis.mobilyllc.com/mobilylogin/mobicon.png">
    <link rel="shortcut icon" href="https://mis.mobilyllc.com/mobilylogin/mobicon.png">

    <link rel="icon" type="image/x-icon" class="js-site-favicon" href="https://mis.mobilelinkusa.com/TestMTDEmp/favicon.ico">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.4.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/css/select2.min.css" rel="stylesheet" />

    <script src="https://mis.mobilelinkusa.com/MTDEmp/Scripts/jquery-3.3.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js"></script>
    <style>

        .bg-red {
            color: white !important;
            background-color: #ff0000 !important;
        }

        .bg-red-first {
            color: white !important;
            background-color: #ff0000 !important;
        }

        .bg-blue-for-unique-store {
            color: white !important;
            background-color: deepskyblue !important;
        }

        .bg-Orange-for-unique-store {
            color: white !important;
            background-color: #e67e22 !important;
        }

        .bgS-green {
            background-color: #174020 !important;
            color: black
        }

        .bg-green {
            background-color: #a9d08e !important;
        }

        .bg-yellow {
            background-color: #f4b084 !important;
        }
        /* Ensure that the demo table scrolls */
        #demoDW {
            width: 100%;
            max-height: 90vh;
            overflow: auto;
        }

        .bd-example-modal-lg .modal-dialog {
            display: table;
            position: relative;
            margin: 0 auto;
            top: calc(50% - 24px);
        }

            .bd-example-modal-lg .modal-dialog .modal-content {
                background-color: transparent;
                border: none;
            }

        .text_color {
            color: #356B09;
            font-weight: bold;
        }

        .bg_blue {
            background-color: #2f5596 !important;
            color: white
        }

        .bg_green {
            background-color: #356B09 !important;
            color: white;
        }

        .myWidth {
            width: 200px !important;
        }

        .b-w-45 {
            width: 48% !important;
        }

        .optionfilter {
            background-color: green;
            border-radius: 6px;
            text-align: center;
            color: white;
            margin-bottom: 5px;
        }

        .selector {
            border-top: 1px dashed green;
        }

        .fixed {
            z-index: 1 !important;
            background-color: #356B09 !important;
            color: white;
            left: 0 !important;
            position: sticky !important;
            text-align: center !important;
        }
        /*  -----------------------------------   */
        table {
            border-collapse: separate;
            border-spacing: 0
        }

        #tbl thead {
            position: sticky;
            top: 0;
            z-index: 11;
        }

        #tbl th[scope=row] {
            left: -1px;
            z-index: 1;
        }

        #tbl th[scope=col] {
            left: -2px;
            z-index: 3;
        }

        #tbl tbody td:nth-child(1),
        #tbl tbody td:nth-child(2),
        #tbl tbody td:nth-child(3),
        #tbl tbody td:nth-child(4),
        #tbl tbody td:nth-child(5) {
            position: sticky;
            z-index: 1;
        }

        #tbl thead th:nth-child(1),
        #tbl thead th:nth-child(2),
        #tbl thead th:nth-child(3),
        #tbl thead th:nth-child(4),
        #tbl thead th:nth-child(5) {
            position: sticky;
            z-index: 12;
        }

        #tbl tbody td:nth-child(1),
        #tbl thead th:nth-child(1) {
            left: 0;
        }

        #tbl tbody td:nth-child(2),
        #tbl thead th:nth-child(2) {
            left: 70px;
        }

        #tbl tbody td:nth-child(3),
        #tbl thead th:nth-child(3) {
            left: 140px;
        }

        #tbl tbody td:nth-child(4),
        #tbl thead th:nth-child(4) {
            left: 210px;
        }

        #tbl tbody td:nth-child(5),
        #tbl thead th:nth-child(5) {
            left: 280px;
        }

        th, td {
            font-size: 9px;
            padding: 4px;
            min-width: 70px;
            max-width: 70px !important;
            text-align: center;
        }

        #tbl tbody td:nth-child(1),
        #tbl tbody td:nth-child(2),
        #tbl tbody td:nth-child(3),
        #tbl tbody td:nth-child(4),
        #tbl tbody td:nth-child(5) {
            background: black;
            color: white;
        }

        .table-bordered thead td, .table-bordered thead th {
            border-bottom-width: 2px;
            background-color: black;
            color: white;
        }

        #excelrow th {
            background-color: #E6E6E6;
            color: black;
            font-size: 9px;
            padding: 0px !important;
            margin: 0px !important;
        }

        table tr td:nth-child(1) {
            background-color: black;
            color: white;
            vertical-align: middle;
        }

        table tr td:nth-child(2) {
            background-color: black;
            color: white;
            vertical-align: middle;
        }

        table tr td:nth-child(3) {
            background-color: black;
            color: white;
            vertical-align: middle;
        }

        table tr td:nth-child(4) {
            background-color: black;
            color: white;
            vertical-align: middle;
        }

        table tr td:nth-child(5) {
            background-color: black;
            color: white;
            vertical-align: middle;
        }

        table tr th {
            background-color: black;
            color: white;
            vertical-align: middle;
        }

        /*  -----------------------------------   */
        input, button {
            height: 25px !important;
            line-height: 8;
            font-weight: bold !important;
            font-size: 10px !important;
        }

        p {
            margin: 0px;
            font-size: 12px;
        }

        .form-group {
            margin-bottom: 6px;
        }

        .select2-container .select2-selection--single {
            box-sizing: border-box;
            cursor: pointer;
            display: block;
            font-size: 10px;
            height: 22px;
            user-select: none;
            -webkit-user-select: none;
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            color: #444;
            line-height: 20px !important;
        }

        #StoresCount {
            color: gray;
            border: 1px dotted green;
            text-align: center;
        }

        #above90 {
            background-color: #008000;
            color: white;
            text-align: center;
        }

        #Lessthen70 {
            background-color: #ff0000;
            color: white;
            text-align: center;
        }

        #Lessthen90 {
            background-color: #f4b084;
            color: white;
            text-align: center;
        }

        .inline-block {
            display: inline-block;
            margin-right: 20px;
        }

        .selector::-webkit-scrollbar {
            width: 5px;
        }

        ::-webkit-scrollbar {
            width: 13px;
        }

        ::-webkit-scrollbar-track {
            box-shadow: inset 0 0 5px #7e5d2e;
            border-radius: 10px;
        }

        /*::-webkit-scrollbar-thumb {
            background: #0079B1;
            border-radius: 10px;
        }*/
        ::-webkit-scrollbar-thumb {
            background: #063b73;
            border-radius: 10px;
        }
            ::-webkit-scrollbar-thumb:hover {
                background: gray;
            }

        h3.heading {
            font-weight: 700;
            background: #063b73;
            color: white;
            padding: 9px;
        }

        input#datefilter {
            width: 18%;
            padding: 13px 5px;
            margin: 10px 0px;
        }

        button#ViewAll {
            padding: 2px 12px;
        }
        input#reprtdateason {
            border: 0 !important;
            background: #063b73;
            color: white;
            font-size: 23px !important;
            font-weight: bold !important;
            margin-left: 8px;
            outline: 0 !important;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 text-center">
                @*<h3 class="heading">Trending Commission Report</h3>*@
                <h3 class="heading">Trending Commission Report as on<input type="date" id="reprtdateason" class="datereport" readonly></h3>
            </div>
        </div>
       
        <div class="row border-bottom">
            <div class="col-lg-12 col-md-12 col-sm-12">
                <label>Date: </label>
                <input id="datefilter" type="date" />
                <button class="btn btn-primary" style="font-size:10px; height:28px" onclick="fetchTrendingCommissionData()" id="ViewAll">Search</button>
                <button class="btn btn-danger" style="font-size:10px; height:28px" onclick="reset()" id="ViewAll">Reset</button>
            </div>
        </div>
        <div class="row mt-3">
            <div class="col-md-12">
                <div class="table-responsive" id="printtable">
                    <div id="imageloader2" style=" padding-left: 543px;"></div>
                    <div id="demoDW">
                        <table cellspacing="0" id="tbl" class="table-bordered" style="width:100%">
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/fixedcolumns/4.3.2/css/fixedColumns.dataTables.min.css">   
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.12/js/select2.min.js"></script>
    <script>

        function createTableHeader() {

            function getAlphabetFromNumber(number) {
                let result = '';
                while (number > 0) {
                    number--; 
                    result = String.fromCharCode('A'.charCodeAt(0) + (number % 26)) + result;
                    number = Math.floor(number / 26);
                }
                return result;
            }

            const headers = [
                { text: "Emp ID", style: "background-color: rgb(6, 59, 115);color:white" },
                { text: "Employees", style: "background-color: rgb(6, 59, 115);color:white"},
                { text: "Role", style: "background-color: rgb(6, 59, 115);color:white" },
                { text: "Store", style: "background-color: rgb(6, 59, 115);color:white"},
                { text: "Store UID", style: "background-color: rgb(6, 59, 115);color:white"},
                { text: "Employee  Rank", style: "background-color: rgb(6, 59, 115);color:white" },
                { text: "Commission  Trending  Bucket", style: "background-color: rgb(6, 59, 115);color:white" },
                { text: "Bucket/  Wage", style: "background-color: rgb(6, 59, 115);color:white" },
                { text: "TOTAL  OPS", style: "background-color: rgb(6, 59, 115);color:white" },
                { text: "CSAT", style: "background-color: rgb(6, 59, 115);color:white" },
                { text: "GROSS ADDS   Net OFF", style: "background-color: rgb(6, 59, 115);color:white" },
                { text: "FN Ach  MTD", style: "background-color: rgb(6, 59, 115);color:white" },
                { text: "CRU Ach  MTD", style: "background-color: rgb(6, 59, 115);color:white" },
                { text: "Next UP", style: "background-color: rgb(6, 59, 115);color:white" },
                { text: "MTD  UPGRADES", style: "background-color: rgb(6, 59, 115);color:white" },
                { text: "AIA  Internet", style: "background-color: rgb(6, 59, 115);color:white" },
                { text: "Fiber  Upgrades", style: "background-color: rgb(6, 59, 115);color:white" },
                { text: "Broadband  + New fiber  Net OFF", style: "background-color: rgb(6, 59, 115);color:white" },
                { text: "Prem Video   Net OFF", style: "background-color: rgb(6, 59, 115);color:white" },
                { text: "Tab+Wear  +Connected Devices Net OFF", style: "background-color: rgb(6, 59, 115);color:white" },
                { text: "Prepaid  Net OFF", style: "background-color: rgb(6, 59, 115);color:white" },
                { text: "Access  $GP", style: "background-color: rgb(6, 59, 115);color:white" },
                { text: "Access  Qty", style: "background-color: rgb(6, 59, 115);color:white" },
                { text: "ProtAdv  1", style: "background-color: rgb(6, 59, 115);color:white" },
                { text: "ProtAdv  4", style: "background-color: rgb(6, 59, 115);color:white" }
            ];

            const table = $("#tbl");
            const thead = $("<thead></thead>");

            // Second header row with alphabetical headers
            const headerRow2 = $("<tr></tr>");
            for (let i = 1; i <= headers.length; i++) {
                const alphabetHeader = getAlphabetFromNumber(i);
                const th = $("<th></th>")
                    .text(alphabetHeader)
                    .css({
                        fontSize: "8px",
                        backgroundColor: "lightgray",
                        color: "black",
                        textAlign: "center"
                    });
                headerRow2.append(th);
            }
            thead.append(headerRow2);

            // First header row
            const headerRow1 = $("<tr></tr>");
            headers.forEach(header => {
                const th = $("<th></th>").text(header.text).css("cssText", header.style);
                headerRow1.append(th);
            });
            thead.append(headerRow1);
            table.append(thead);


            // Create thead element
            //const thead = document.createElement("thead");
            //const headerRow = document.createElement("tr");
            
            //headers.forEach(header => {
            //    const th = document.createElement("th");
            //    th.innerHTML = header.text;
            //    th.style.cssText = header.style; 
            //    if (header.class) {
            //        th.classList.add(header.class); 
            //    }
            //    headerRow.appendChild(th);
            //});
            //thead.appendChild(headerRow);
            //const table = document.getElementById("tbl");
            //table.appendChild(thead);
        }
        function TrendingCommissionData(data) {
            $('#tbl').empty();
            createTableHeader();
            const table = document.getElementById("tbl");

            let tableBody = table.querySelector("tbody");
            if (!tableBody) {
                tableBody = document.createElement("tbody");
                table.appendChild(tableBody);  
            }

            // Loop through each data row
            data.forEach(row => {
                const tr = document.createElement("tr");

                // Create table cells (td) for each column
                const empIdTd = document.createElement("td");
                empIdTd.textContent = row.EmpID;
                tr.appendChild(empIdTd);

                const empNameTd = document.createElement("td");
                empNameTd.textContent = row.EmpName;
                tr.appendChild(empNameTd);

                const roleTd = document.createElement("td");
                roleTd.textContent = row.Role;
                tr.appendChild(roleTd);

                const storeTd = document.createElement("td");
                storeTd.textContent = row.Store;
                tr.appendChild(storeTd);

                const storeUidTd = document.createElement("td");
                storeUidTd.textContent = row.StoreUID;
                tr.appendChild(storeUidTd);

                const employeeRankTd = document.createElement("td");
                employeeRankTd.textContent = row.EmployeeRank;
                tr.appendChild(employeeRankTd);

                const bucketWageTd = document.createElement("td");
                if (row.BucketWage === "Bucket") {
                    bucketWageTd.innerHTML = `<span style="color:white; background-color: #063b73; display: inline-block; width: 100%;">$${Math.round(parseFloat(row.EOMCommissionTrendingBucket)).toLocaleString()}</span>`;
                } else {
                    bucketWageTd.textContent = `$${Math.round(parseFloat(row.EOMCommissionTrendingBucket)).toLocaleString()}`;
                }
                tr.appendChild(bucketWageTd);

                const bucketWageTextTd = document.createElement("td");
                bucketWageTextTd.textContent = row.BucketWage;
                tr.appendChild(bucketWageTextTd);

                const totalOpsTd = document.createElement("td");
                totalOpsTd.textContent = row.TOTALOPS;
                tr.appendChild(totalOpsTd);

                const csatTd = document.createElement("td");
                csatTd.textContent = parseFloat(row.CSAT).toFixed(2) + "%";
                tr.appendChild(csatTd);

                const grossAddsTd = document.createElement("td");
                grossAddsTd.textContent = row.GROSSADDSNetOFF;
                tr.appendChild(grossAddsTd);

                const fnAchMtdTd = document.createElement("td");
                fnAchMtdTd.textContent = row.FNAchMTD;
                tr.appendChild(fnAchMtdTd);

                const cruAchMtdTd = document.createElement("td");
                cruAchMtdTd.textContent = row.CRUAchMTD;
                tr.appendChild(cruAchMtdTd);

                const nextUpTd = document.createElement("td");
                nextUpTd.textContent = row.NextUP;
                tr.appendChild(nextUpTd);

                const mtdUpgradesTd = document.createElement("td");
                mtdUpgradesTd.textContent = row.MTDUPGRADES;
                tr.appendChild(mtdUpgradesTd);

                const aiaInternetTd = document.createElement("td");
                aiaInternetTd.textContent = row.AIAInternet;
                tr.appendChild(aiaInternetTd);

                const fiberUpgradesTd = document.createElement("td");
                fiberUpgradesTd.textContent = row.FiberUpgrades;
                tr.appendChild(fiberUpgradesTd);

                const broadbandNetOffTd = document.createElement("td");
                broadbandNetOffTd.textContent = row.BroadbandNewfiberNetOFF;
                tr.appendChild(broadbandNetOffTd);

                const premVideoNetOffTd = document.createElement("td");
                premVideoNetOffTd.textContent = row.PremVideoNetOFF;
                tr.appendChild(premVideoNetOffTd);

                const tabWearNetOffTd = document.createElement("td");
                tabWearNetOffTd.textContent = row.TabWearConnectedDevicesNetOFF;
                tr.appendChild(tabWearNetOffTd);

                const prepaidNetOffTd = document.createElement("td");
                prepaidNetOffTd.textContent = row.PrepaidNetOFF;
                tr.appendChild(prepaidNetOffTd);

                const accessGpTd = document.createElement("td");
                accessGpTd.textContent = `$${Math.round(row.AccessGP).toLocaleString()}`;
                tr.appendChild(accessGpTd);

                const accessQtyTd = document.createElement("td");
                accessQtyTd.textContent = row.AccessQty;
                tr.appendChild(accessQtyTd);

                const protAdv1Td = document.createElement("td");
                protAdv1Td.textContent = row.ProtAdv1;
                tr.appendChild(protAdv1Td);

                const protAdv4Td = document.createElement("td");
                protAdv4Td.textContent = row.ProtAdv4;
                tr.appendChild(protAdv4Td);

                tableBody.appendChild(tr);
            });
        }

        function fetchTrendingCommissionData() {
            $("#imageloader2").show();
            var datefilter = $('#datefilter').val() || "";
            $.ajax({
                type: "GET",
                url: "TrendingCommissionData",
                data: { date: datefilter },
                success: function (response) {
                    TrendingCommissionData(response);
                    $("#imageloader2").hide();
                    $.each(response, function (i, item) {
                        $('#datefilter').val(item.MaxDate);
                        $('#reprtdateason').val(item.MaxDate);
                    });
                        
                },
                error: function (error) {
                    console.error("Error fetching data:", error);
                    $("#imageloader2").hide();
                }
            });
        }

        $(document).ready(function () {
            fetchTrendingCommissionData();
        });
        function reset() {
            location.reload();
        }
    </script>
</body>
</html>

