    <style>

        .bg-red {
            color: white !important;
            background-color: #ff0000 !important;
        }

        .bg-red-first {
            color: white !important;
            background-color: #ff0000 !important;
        }

        .bg-blue-for-unique-store {
            color: white !important;
            background-color: deepskyblue !important;
        }

        .bg-Orange-for-unique-store {
            color: white !important;
            background-color: #e67e22 !important;
        }

        .bgS-green {
            background-color: #174020 !important;
            color: black
        }

        .bg-green {
            background-color: #a9d08e !important;
        }

        .bg-yellow {
            background-color: #f4b084 !important;
        }
        /* Ensure that the demo table scrolls */
        #demoDW {
            width: 100%;
            max-height: 90vh;
            overflow: auto;
        }

        .bd-example-modal-lg .modal-dialog {
            display: table;
            position: relative;
            margin: 0 auto;
            top: calc(50% - 24px);
        }

            .bd-example-modal-lg .modal-dialog .modal-content {
                background-color: transparent;
                border: none;
            }

        .text_color {
            color: #356B09;
            font-weight: bold;
        }

        .bg_blue {
            background-color: #2f5596 !important;
            color: white
        }

        .bg_green {
            background-color: #356B09 !important;
            color: white;
        }

        .myWidth {
            width: 200px !important;
        }

        .b-w-45 {
            width: 48% !important;
        }

        .optionfilter {
            background-color: green;
            border-radius: 6px;
            text-align: center;
            color: white;
            margin-bottom: 5px;
        }

        .selector {
            border-top: 1px dashed green;
        }

        .fixed {
            z-index: 1 !important;
            background-color: #356B09 !important;
            color: white;
            left: 0 !important;
            position: sticky !important;
            text-align: center !important;
        }
        /*  -----------------------------------   */
        table {
            border-collapse: separate;
            border-spacing: 0
        }

        #tbl thead {
            position: sticky;
            top: 0;
            z-index: 11;
        }

        #tbl th[scope=row] {
            left: -1px;
            z-index: 1;
        }

        #tbl th[scope=col] {
            left: -2px;
            z-index: 3;
        }

        #tbl tbody td:nth-child(1),
        #tbl tbody td:nth-child(2),
        #tbl tbody td:nth-child(3),
        #tbl tbody td:nth-child(4),
        #tbl tbody td:nth-child(5) {
            position: sticky;
            z-index: 1;
        }

        #tbl thead th:nth-child(1),
        #tbl thead th:nth-child(2),
        #tbl thead th:nth-child(3),
        #tbl thead th:nth-child(4),
        #tbl thead th:nth-child(5){
            position: sticky;
            z-index: 12;
        }

        #tbl tbody td:nth-child(1),
        #tbl thead th:nth-child(1) {
            left: 0;
        }

        #tbl tbody td:nth-child(2),
        #tbl thead th:nth-child(2) {
            left: 70px;
        }

        #tbl tbody td:nth-child(3),
        #tbl thead th:nth-child(3) {
            left: 140px;
        }

        #tbl tbody td:nth-child(4),
        #tbl thead th:nth-child(4) {
            left: 210px;
        }

        #tbl tbody td:nth-child(5),
        #tbl thead th:nth-child(5) {
            left: 280px;
        }

        th, td {
            font-size: 9px;
            padding: 4px;
            min-width: 70px;
            max-width: 70px !important;
            text-align: center;
        }
        #tbl tbody td:nth-child(1),
        #tbl tbody td:nth-child(2),
        #tbl tbody td:nth-child(3),
        #tbl tbody td:nth-child(4),
        #tbl tbody td:nth-child(5) {
            background: black;
            color: white;
        }

        .table-bordered thead td, .table-bordered thead th {
            border-bottom-width: 2px;
            background-color: black;
            color: white;
        }

        #excelrow th {
            background-color: #E6E6E6;
            color: black;
            font-size: 9px;
            padding: 0px !important;
            margin: 0px !important;
        }

        table tr td:nth-child(1) {
            background-color: black;
            color: white;
            vertical-align: middle;
        }

        table tr td:nth-child(2) {
            background-color: black;
            color: white;
            vertical-align: middle;
        }

        table tr td:nth-child(3) {
            background-color: black;
            color: white;
            vertical-align: middle;
        }

        table tr td:nth-child(4) {
            background-color: black;
            color: white;
            vertical-align: middle;
        }
        table tr td:nth-child(5) {
            background-color: black;
            color: white;
            vertical-align: middle;
        }
        table tr th {
            background-color: black;
            color: white;
            vertical-align: middle;
        }

        /*  -----------------------------------   */
        input, button {
            height: 25px !important;
            line-height: 8;
            font-weight: bold !important;
            font-size: 10px !important;
        }

        p {
            margin: 0px;
            font-size: 12px;
        }

        .form-group {
            margin-bottom: 6px;
        }

        .select2-container .select2-selection--single {
            box-sizing: border-box;
            cursor: pointer;
            display: block;
            font-size: 10px;
            height: 22px;
            user-select: none;
            -webkit-user-select: none;
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            color: #444;
            line-height: 20px !important;
        }

        #StoresCount {
            color: gray;
            border: 1px dotted green;
            text-align: center;
        }

        #above90 {
            background-color: #008000;
            color: white;
            text-align: center;
        }

        #Lessthen70 {
            background-color: #ff0000;
            color: white;
            text-align: center;
        }

        #Lessthen90 {
            background-color: #f4b084;
            color: white;
            text-align: center;
        }

        .inline-block {
            display: inline-block;
            margin-right: 20px;
        }

        .selector::-webkit-scrollbar {
            width: 5px;
        }

        ::-webkit-scrollbar {
            width: 13px;
        }

        ::-webkit-scrollbar-track {
            box-shadow: inset 0 0 5px #7e5d2e;
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb {
            background: #0079B1;
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: gray;
        }
        h3.heading {
            font-weight: 700;
            background: #0079b1;
            color: white;
            padding: 9px;
        }
        input#datefilter {
            width: 18%;
            padding: 13px 5px;
            margin: 10px 0px;
        }
        button#ViewAll {
            padding: 2px 12px;
        }
    </style>
</head>
