            function filterData(filterValue, ddName) {

                FilteredData.status = $(CurrentData.status).filter(function (idx) {

                    switch (filterValue) {
                        case 'Select VP':
                        case 'Select AVP':
                        case 'Select Area':
                        case 'Select SSM':
                        case 'Select SSD':
                        case 'Select SD':
                        case 'Select Market':
                        case 'Select Tier':
                        case 'Select TM':
                        case 'Select SRSM Store':
                        case 'Select SRSM':
                        case 'Select Store':
                        case 'Select Employee':
                            return FilteredData.status;
                            break;

                        default:
                            switch (ddName) {
                                case 'Lessthen90':
                                    return CurrentData.status[idx].Opps_Trending_Per >= 70 && CurrentData.status[idx].Opps_Trending_Per <= 90;
                                case 'Lessthen70':
                                    return CurrentData.status[idx].Opps_Trending_Per < 70;
                                case 'above90':
                                    return CurrentData.status[idx].Opps_Trending_Per > 90;
                                case 'VP':
                                    return CurrentData.status[idx].VP === filterValue;
                                    break;
                                case 'AVP':
                                    return CurrentData.status[idx].AVP === filterValue;
                                    break;
                                case 'Area':
                                    return CurrentData.status[idx].Area === filterValue;
                                    break;
                                case 'SSM':
                                    return CurrentData.status[idx].SSM === filterValue;
                                    break;
                                case 'SSD':
                                    return CurrentData.status[idx].SSD === filterValue;
                                    break;
                                case 'SD':
                                    return CurrentData.status[idx].SD === filterValue;
                                    break;
                                case 'Market':
                                    return CurrentData.status[idx].Market === filterValue;
                                    break;
                                case 'Tier':
                                    return CurrentData.status[idx].Tier === filterValue;
                                    break;
                                case 'TM':
                                    return CurrentData.status[idx].TM === filterValue;
                                    break;
                                case 'SRSMStore':
                                    return CurrentData.status[idx].SRSM_Store_Count === filterValue;
                                    break;
                                case 'SRSM':
                                    return CurrentData.status[idx].SRSM === filterValue;
                                    break;
                                case 'Store':
                                    return CurrentData.status[idx].Location === filterValue;
                                    break;
                                case 'Employee':
                                    return CurrentData.status[idx].RSM === filterValue;
                                    break;
                                default:
                                    return CurrentData.status;
                            }
                    }

                });

                GrandTotal();
