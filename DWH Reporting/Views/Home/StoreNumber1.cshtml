<script type="text/javascript">
    function showDiv(divId, btnId) {

        var divs = document.querySelectorAll('div[id^="zero"]');
        for (var i = 0; i < divs.length; i++) {

            if (divs[i].id !== divId) {
                divs[i].style.display = "none";
            }
        }

        // Show the clicked div
        var div = document.getElementById(divId);
        div.style.display = "block";

        var abcDiv = document.getElementById("abc");
        abcDiv.style.display = "none";

        // Reset background color of all buttons
        document.getElementById("btnG").classList.remove("green");
        document.getElementById("btnO").classList.remove("green");
        document.getElementById("btnN").classList.remove("green");

        // Change the color of the clicked button to green
        document.getElementById(btnId).classList.add("green");

        // Change heading text to the value of the selected button
        var heading = document.querySelector('.GP_heading');
        var buttonValue = document.getElementById(btnId).value;
        heading.innerText = buttonValue;
    }


</script>
