<script>


    function loadDataTable() {
        debugger;
        var table, count;


        table = $('#example').DataTable({
            "paging": false,
            "ordering": true,
            "info": true,
            "scrollY": true,
            "scrollCollapse": true,
            "language": {
                "emptyTable": "No data available in this Report",
                "searchPlaceholder": "Search records"
            },
            "retrieve": true,
            "fixedHeader": true,
            "scrollX": true,
            "columnDefs": [
                {
                    "targets": [0,1,2,3,4],
                    "className": "editable-section-rows"
                }],
            dom: 'Bfrtip',
            buttons: [
                'copyHtml5',
                'excelHtml5',
                'csvHtml5',
                'pdfHtml5',
                'print'],
            fixedColumns: {
                leftColumns: 5
            }
        });


        table.clear();
        $("#imageloader2").hide();

        $.ajax({
            type: "Get",
            url: "TrendingCommissionData",
            success: function (data) {
                $("#imageloader2").hide();

                if (data != '') {
                    $.each(data, function (i, item) {

                        table.row.add([

                            item.EmpID, item.EmpName, item.Role, item.Store, item.StoreUID, item.EmployeeRank
                            , item.BucketWage === 'Bucket'
                                ? `<span style="color:white ;background-color: #597a97; display: inline-block; width: 100%;">${item.EOMCommissionTrendingBucket}</span>`
                                : item.EOMCommissionTrendingBucket,

                            item.BucketWage,
                            item.TOTALOPS,
                            item.CSAT,
                            item.GROSSADDSNetOFF,
                            item.FNAchMTD,
                            item.CRUAchMTD,
                            item.NextUP,
                            item.MTDUPGRADES,
                            item.AIAInternet,
                            item.FiberUpgrades,
                            item.BroadbandNewfiberNetOFF,
                            item.PremVideoNetOFF,
                            item.TabWearConnectedDevicesNetOFF,
                            item.PrepaidNetOFF,
                            item.AccessGP,
                            item.AccessQty,
                            item.ProtAdv1,
                            item.ProtAdv4,

                        ]);

                    })

                }

                table.draw();

                //table.columns.adjust().fixedColumns().relayout();

                //console.log(data);
            },
            error: function () { }
        });
    }

    function reset() {
        location.reload();
    }

    function exportToExcel() {


        window.location.href = 'AdminExportToExcel?statusid=' + statusid + '&sdate=' + sdate + '&edate=' + edate;

    }

</script>





