@{
    ViewBag.Title = "HandbookAgreementsReport";
    Layout = "~/Views/Shared/_GPLayout.cshtml";
}
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.0.1/css/toastr.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.0.1/js/toastr.js"></script>
<link href="https://cdn.datatables.net/1.10.21/css/jquery.dataTables.min.css" rel="stylesheet" />
<link href="~/assets/css/reportscss.css" rel="stylesheet" />
<link href="https://cdn.datatables.net/fixedcolumns/3.2.0/css/fixedColumns.dataTables.min.css" rel="stylesheet" />
<link href="~/assets/css/RptTemplate.css" rel="stylesheet" />
<link rel="stylesheet" href="~/assets/css/style.css">

<style>
    .Reporthead h3 {
        color: white;
        font-weight: 800;
        text-align: center;
    }

    .Reporthead {
        background: #0079b1;
        padding: 6px;
    }

    .table-bordered > thead > tr > th, .table-bordered > tbody > tr > th, .table-bordered > tfoot > tr > th, .table-bordered > thead > tr > td, .table-bordered > tbody > tr > td, .table-bordered > tfoot > tr > td {
        border: 1px solid #ddd;
        text-align: center;
    }

    table#example tr td {
        padding: 4px 10px !important;
    }

    /*#example tbody tr td:nth-child(-n+3) {
        position: sticky;
        left: 0;
        z-index: 3;
    }*/


    /*.dataTables_wrapper .dataTables_scrollBody {
        position: relative;
        clear: both;
        width: 700px;
        min-height: 62vh !important;
        margin-left: 0px;
        zoom: 1;
    }*/
   
</style>

<div class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="card" id="crd">
                <div class="card-header">
                    <strong class="card-title">Trending Commissions</strong>
                </div>
                <div class="card-body">
                    <div class="row mt-4 mb-3">
                        <div class="col-md-12" style="padding-bottom:1px">
                            <label>Date: </label>
                            <input id="datefilter" type="date" />
                            <button class="btn btn-primary" style="font-size:10px; height:28px" onclick="loadDataTable()" id="ViewAll">Search</button>
                            <button class="btn btn-danger" style="font-size:10px; height:28px" onclick="reset()" id="ViewAll">Reset</button>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 mt-3">
                            <div class="Reporthead">
                                <h3>Report as on <span id="reportdate"></span></h3>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-4">
                        <div id="imageloader2" style=" padding-left: 543px;"></div>
                        <div class="col-sm-12">
                            <table id="example" class="table-bordered table-striped datatable" style="width:100%;">
                                <thead>
                                    <tr>
                                        <th style="background-color: rgb(6, 59, 115);color:white" class="FixColumns">Emp ID</th>
                                        <th style="background-color: rgb(6, 59, 115);color:white" class="FixColumns">Employees</th>
                                        <th style="background-color: rgb(6, 59, 115);color:white" class="FixColumns">Role</th>
                                        <th style="background-color: rgb(6, 59, 115);color:white" class="FixColumns">Store</th>
                                        <th style="background-color: rgb(6, 59, 115);color:white" class="FixColumns">Store <br />UID</th>
                                        <th style="background-color: rgb(6, 59, 115);color:white">Employee <br />Rank</th>
                                        <th style="background-color: #404040;color:white">Commission <br />Trending <br />Bucket</th>
                                        <th style="background-color: #404040;color:white">Bucket/<br /> Wage</th>
                                        <th style="background-color: #404040;color:white">TOTAL<br /> OPS</th>
                                        <th style="background-color: #404040;color:white">CSAT</th>
                                        <th style="background-color: #404040;color:white">GROSS ADDS <br /> Net OFF</th>
                                        <th style="background-color: #404040;color:white">FN Ach <br />MTD</th>
                                        <th style="background-color: #404040;color:white">CRU Ach<br /> MTD</th>
                                        <th style="background-color: #404040;color:white">Next UP</th>
                                        <th style="background-color: #404040;color:white">MTD<br /> UPGRADES</th>
                                        <th style="background-color: #404040;color:white">AIA <br />Internet</th>
                                        <th style="background-color: #404040;color:white">Fiber <br />Upgrades</th>
                                        <th style="background-color: #404040;color:white">Broadband <br />+ New fiber<br /> Net OFF</th>
                                        <th style="background-color: #404040;color:white">Prem Video<br />  Net OFF</th>
                                        <th style="background-color: #404040;color:white">Tab+Wear <br />+Connected Devices<br /> Net OFF</th>
                                        <th style="background-color: #404040;color:white">Prepaid <br />Net OFF</th>
                                        <th style="background-color: #404040;color:white">Access<br /> $GP</th>
                                        <th style="background-color: #404040;color:white">Access <br />Qty</th>
                                        <th style="background-color: #404040;color:white">ProtAdv<br /> 1</th>
                                        <th style="background-color: #404040;color:white">ProtAdv <br />4</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>

                            </table>
                        </div>
                    </div>
                </div>
            </div>


        </div>

        <!-- /#add-category -->
    </div>
</div>


<script>
    $(document).ready(function () {
        loadDataTable();
    });

    function loadDataTable() {

        var table, count;
        table = $('#example').DataTable({
            "paging": false,
            "ordering": true,
            "info": true,
            "scrollY": "500px",
            "scrollCollapse": true,
            "language": {
                "emptyTable": "No data available in this Report",
                "searchPlaceholder": "Search records"
            },
            "retrieve": true,
            "fixedHeader": true,
            "scrollX": true,
            "columnDefs": [
                {
                    "targets": [0, 1, 2, 3, 4],
                    "className": "editable-section-rows",
                }
            ],
            dom: 'Bfrtip',
            buttons: [
                'copyHtml5',
                'excelHtml5',
                'csvHtml5',
                'pdfHtml5',
                'print'
            ],
            fixedColumns: {
                leftColumns: 5
            },
            createdRow: function (row, data, dataIndex) {
                $(row).find('.DTFC_LeftBodyLiner').css('overflow-x', 'hidden');
            }
        });
        table.clear();
        $('#reportdate').text('');

        $("#imageloader2").hide();
        var datefilter = $('#datefilter').val() || "";

        $.ajax({
            type: "Get",
            url: "TrendingCommissionData",
            data: { date: datefilter },
            success: function (data) {
                $("#imageloader2").hide();
                if (data != '') {
                    $.each(data, function (i, item) {
                        var rpdate = new Date(item.MaxDate).toLocaleDateString();
                        $('#datefilter').val(item.MaxDate)
                        $('#reportdate').text(rpdate);
                        table.row.add([
                            item.EmpID, item.EmpName, item.Role, item.Store, item.StoreUID, item.EmployeeRank,
                            item.BucketWage === 'Bucket'
                                ? `<span style="color:white; background-color: #063b73; display: inline-block; width: 100%;">$${Math.round(parseFloat(item.EOMCommissionTrendingBucket)).toLocaleString()}</span>`
                                : `$${Math.round(parseFloat(item.EOMCommissionTrendingBucket)).toLocaleString()}`,
                            //, item.BucketWage === 'Bucket'
                            //    ? `<span style="color:white ;background-color: #063b73; display: inline-block; width: 100%;">${"$" +parseFloat(item.EOMCommissionTrendingBucket).toFixed(2) } </span>`
                            //    : "$" + parseFloat(item.EOMCommissionTrendingBucket).toFixed(2) ,
                            item.BucketWage,
                            item.TOTALOPS,
                            parseFloat(item.CSAT).toFixed(2) + "%", 
                            item.GROSSADDSNetOFF,
                            item.FNAchMTD,
                            item.CRUAchMTD,
                            item.NextUP,
                            item.MTDUPGRADES,
                            item.AIAInternet,
                            item.FiberUpgrades,
                            item.BroadbandNewfiberNetOFF,
                            item.PremVideoNetOFF,
                            item.TabWearConnectedDevicesNetOFF,
                            item.PrepaidNetOFF,
                            "$" + Math.round(item.AccessGP).toLocaleString(),
                            item.AccessQty,
                            item.ProtAdv1,
                            item.ProtAdv4,

                        ]);

                    })

                }

                table.draw();
                //table.columns.adjust().fixedColumns().relayout();
            },
            error: function () { }
        });
    }

    function reset() {
        location.reload();
    }

</script>





