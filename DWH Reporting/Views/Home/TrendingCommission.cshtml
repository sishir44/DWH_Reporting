<script>

    $(document).ready(function () {
        loadDataTable();

    });

    //$('#datefilter').change(function () {
    //    var dateshow = $('#datefilter').val();
    //    var dateval = new Date(dateshow).toLocaleDateString();
    //    $('#reportdate').text(dateval);
    //});
    function loadDataTable() {

        var table, count;
        table = $('#example').DataTable({
            "paging": false,
            "ordering": true,
            "info": true,
            "scrollY": true,
            "scrollCollapse": true,
            "language": {
                "emptyTable": "No data available in this Report",
                "searchPlaceholder": "Search records"
            },
            "retrieve": true,
            "fixedHeader": true,
            "scrollX": true,
            "columnDefs": [
                {
                    "targets": [0, 1, 2, 3, 4],
                    "className": "editable-section-rows"
                }],
            dom: 'Bfrtip',
            buttons: [
                'copyHtml5',
                'excelHtml5',
                'csvHtml5',
                'pdfHtml5',
                'print'],
            fixedColumns: {
                leftColumns: 5
            }
        });

        $('#reportdate').text('');
        table.clear();
        $("#imageloader2").hide();
        var datefilter = $('#datefilter').val() || "";

        $.ajax({
            type: "Get",
            url: "TrendingCommissionData",
            data: { date: datefilter },
            success: function (data) {
                $("#imageloader2").hide();

                if (data != '') {
                    $.each(data, function (i, item) {
                        var rpdate = new Date(item.MaxDate).toLocaleDateString();

                        $('#reportdate').text(rpdate);

                        // Set the value of the date input with id #datefilter (for date picker)
                        var originalDate = new Date(item.MaxDate);

                        // Log the original date to understand its format
                        //console.log("Original Date: " + originalDate);

                        // Manually extract the year, month, and day (without time zone conversion)
                        var year = originalDate.getFullYear();
                        var month = (originalDate.getMonth() + 1).toString().padStart(2, '0'); // getMonth() is zero-based
                        var day = originalDate.getDate().toString().padStart(2, '0'); // getDate() returns the day of the month

                        // Format the date as yyyy-mm-dd
                        var formattedDate = `${year}-${month}-${day}`;

                        // Log the formatted date to check correctness
                        //console.log("Formatted Date: " + formattedDate);

                        // Set the value of the input field with id #datefilter (input type="date")
                        $('#datefilter').val(formattedDate);

                        table.row.add([

                            item.EmpID, item.EmpName, item.Role, item.Store, item.StoreUID, item.EmployeeRank
                            , item.BucketWage === 'Bucket'
                                ? `<span style="color:white ;background-color: #597a97; display: inline-block; width: 100%;">${parseFloat(item.EOMCommissionTrendingBucket).toFixed(2) + " $"} </span>`
                                : parseFloat(item.EOMCommissionTrendingBucket).toFixed(2) + " $",

                            item.BucketWage,
                            item.TOTALOPS,
                            parseFloat(item.CSAT).toFixed(2) + " %",
                            item.GROSSADDSNetOFF,
                            item.FNAchMTD,
                            item.CRUAchMTD,
                            item.NextUP,
                            item.MTDUPGRADES,
                            item.AIAInternet,
                            item.FiberUpgrades,
                            item.BroadbandNewfiberNetOFF,
                            item.PremVideoNetOFF,
                            item.TabWearConnectedDevicesNetOFF,
                            item.PrepaidNetOFF,
                            item.AccessGP + " $",
                            item.AccessQty,
                            item.ProtAdv1,
                            item.ProtAdv4,

                        ]);

                    })

                }

                table.draw();

                //table.columns.adjust().fixedColumns().relayout();
            },
