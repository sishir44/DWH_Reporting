                        {
                            foreach (var item in ViewBag.StoresList)
                            {
                                <option class="optionfilter" value="@item.Value">@item.Text</option>
                            }
                        }
                        else
                        {
                            <option class="optionfilter" disabled>No Stores available</option>
                        }
                    </select>
                </div>
                <!-- Search Tiers -->
                <div id="TiersSection" class="col-lg-12 col-md-12 col-sm-12 col-xs-12 d-none">
                    <input type="text" name="textSearchTiers" id="textSearchTiers" class="selectorinput form-control" placeholder="Search Tiers" onkeyup="TiersFilter()" />
