<body style="padding-top:0; background-color:#B2D6F2;">
    <div id="div1" class="content" style="background-color:#B2D6F2;">
        <div class="d-flex justify-content-between align-items-center">
            <!-- Title on the left -->
            <h3 class="title mb-0" style="font-weight: 800; font-size: 16px;">| Store Summary</h3>

            <!-- Input and Button on the right -->
            <div class="d-flex align-items-center gap-2">
                @using (Html.BeginForm("SummaryMobileView", "MobileView", FormMethod.Post))
                {
                    <input type="date"
                           id="selectedDate"
                           name="selectedDate"
                           class="form-control w-auto"
                           title="Select Date"
                           style="background-color:#A5CFF0; font-size: 12px; font-weight: bold; height: 30px; color:#383b3f; border:black;"
                           onchange="appendUserIDToURL(this.form);"
                           max="@yesterday" />
                }

                <button type="submit" class="btn btn-primary w-auto" title="First Load Data" onclick="refresh()">
                    <i class="fas fa-retweet"></i>
                </button>
            </div>
        </div>
        <div class="row sub-header">
            <div class="row">
                <!-- INDICATORS -->
                <div class="container">
                    <div class="row d-flex align-items-center text-center">
                        <!-- Column 1 -->
                        <div class="col-3">
                            <label class="d-block">Stores</label>
                            <input type="button" id="storeCountDisplay" class="form-control btn-custom"
                                   value="0" style="background-color:#31869b; color: white; width: 100%;" />
                        </div>
                        <!-- Column 2 -->
                        <div class="col-3">
                            <label class="d-block">>100%</label>
                            <input type="button" id="GATrGoal100" class="form-control btn-custom"
                                   title="100% & Above" value="" style="background-color: green; color: white; width: 100%;" />
                        </div>
                        <!-- Column 3 -->
                        <div class="col-3">
                            <label class="d-block">>70%</label>
                            <input type="button" id="GATrGoal90" class="form-control btn-custom"
                                   title="70% & Above" value="" style="background-color: orange; color: white; width: 100%;" />
                        </div>
                        <!-- Column 4 -->
                        <div class="col-3">
                            <label class="d-block">< 70%</label>
                            <input type="button" id="GATrGoal70" class="form-control btn-custom"
                                   title="Less Than 70%" value="" style="background-color: red; color: white; width: 100%;" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- FILTERS -->
        <div class="row mt-1">
            <div class="col-md-12 col-sm-12 col-12 mb-2">
                <div class="div" style="display: flex; flex-wrap: nowrap;overflow-x: auto;">
                    <div class="col-sm-3 col-3 text-center border p-2">
