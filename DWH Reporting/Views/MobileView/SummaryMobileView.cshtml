                                <input type="text" name="textSearchMarket" id="toggleMKT" class="selectorinput form-control" placeholder="Market" onclick="toggleVisibility('MarketSection')" />

                            </div>
                        </div>
                    </div>
                    <div class="col-sm-3 col-3 text-center border p-2">
                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 col-12">
                                <input type="text" name="textSearchStore" id="toggleStore" class="selectorinput form-control" placeholder="Store" onclick="toggleVisibility('StoresSection')" />

                            </div>
                        </div>
                    </div>
                    <div class="col-sm-3 col-3 text-center border p-2">
                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 col-12">
                                <input type="text" name="textSearchTiers" id="toggleTiers" class="selectorinput form-control" placeholder="Tiers" onclick="toggleVisibility('TiersSection')" />

                            </div>
                        </div>
                    </div>
                </div>
                <!-- Search TM -->
                <div id="TMSection" class="col-lg-12 col-md-12 col-sm-12 col-xs-12 d-none">
                    <input type="text" name="textSearchTM" id="textSearchTM" class="selectorinput form-control" placeholder="Search TM" onkeyup="TMFilter()" />
                    <select class="form-control selector" id="TM" multiple onchange="filterTMData()">
                        @if (ViewBag.TMList != null && ViewBag.TMList.Count > 0)
                        {
                            foreach (var item in ViewBag.TMList)
                            {
                                <option class="optionfilter" value="@item.Value">@item.Text</option>
                            }
                        }
                        else
                        {
                            <option class="optionfilter" disabled>No TM available</option>
                        }
                    </select>
                </div>
                <!-- Search Market -->
                <div id="MarketSection" class="col-lg-12 col-md-12 col-sm-12 col-xs-12 d-none">
                    <input type="text" name="textSearchMarket" id="textSearchMarket" class="selectorinput form-control" placeholder="Search Market" onkeyup="MarketFilter()" />
                    <select class="form-control selector" id="Market" multiple onchange="filterMarketData()">
                        @if (ViewBag.MarketList != null && ViewBag.MarketList.Count > 0)
                        {
                            foreach (var item in ViewBag.MarketList)
                            {
                                <option class="optionfilter" value="@item.Value">@item.Text</option>
                            }
                        }
                        else
                        {
                            <option class="optionfilter" disabled>No Market available</option>
                        }
                    </select>
                </div>
                <!-- Search Stores -->
                <div id="StoresSection" class="col-lg-12 col-md-12 col-sm-12 col-xs-12 d-none">
                    <input type="text" name="textSearchStores" id="textSearchStores" class="selectorinput form-control" placeholder="Search Stores" onkeyup="StoresFilter()" />
                    <select class="form-control selector" id="Stores" multiple onchange="filterStoresData()">
