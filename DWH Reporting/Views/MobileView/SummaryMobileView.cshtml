<script type="text/javascript">
    function appendUserIDToURL(form) {
        // Get the selected date value
        var selectedDate = document.getElementById('selectedDate').value;

        // Get the current URL to append the parameters
        var currentURL = window.location.href;

        // Check if userid is already in the URL
        var userid = '@userID';
        if (userid && !currentURL.includes('userid=')) {
            // If userid is not already in the URL, append it
            currentURL = currentURL.indexOf('?') > -1 ? currentURL + '&userid=' + userid + '&selectedDate=' + selectedDate : currentURL + '?userid=' + userid + '&selectedDate=' + selectedDate;
        } else {
            // If userid is already present, just append the date
            currentURL = currentURL.replace(/(selectedDate=)([^&]*)/, '$1' + selectedDate); // Update selectedDate if it exists
        }

        // Set the form action to the new URL
        form.action = currentURL;
        form.submit(); // Submit the form
    }
</script>

